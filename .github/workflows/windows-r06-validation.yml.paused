name: Sunrise File Manager R06 Windows UI verification

on:
  push:
    branches: [validation/v1.7.0-r06-windows]
    paths:
      - 'source/**'
      - 'r06-validation-kit/**'
      - 'RELEASE_STATUS.json'
      - '.r06_payload/**'
      - '.github/workflows/windows-r06-validation.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  r06-windows:
    runs-on: windows-2025
    env:
      PYTHONUTF8: '1'
      PYTHONIOENCODING: 'utf-8'
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
      - name: Extract and fingerprint R06 source/Windows kit
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $source = '.r06_payload/Sunrise_File_Manager_v1.7.0_R06_CI_source.zip'
          $kit = '.r06_payload/Sunrise_File_Manager_v1.7.0_R06_Windows_실기검증_키트.zip'
          foreach($file in @($source,$kit)) { if (!(Test-Path $file)) { throw "Verification payload missing: $file" } }
          if ((Get-FileHash $source -Algorithm SHA256).Hash.ToLowerInvariant() -ne '896f9c6b2ccb847f7b91ba20e7d6ba1b96ba6c60b445de1c980f42d791912b6b') { throw 'R06 source ZIP digest mismatch' }
          if ((Get-FileHash $kit -Algorithm SHA256).Hash.ToLowerInvariant() -ne '27153d8235c22eac3255ec0b6636b65a17267e0ed315392ff6522b23ca415c39') { throw 'R06 native UI kit ZIP digest mismatch' }
          foreach ($old in @('source','tests','docs','build-tools','validation','installer','release','ui-audit')) {
            if (Test-Path $old) { Remove-Item $old -Recurse -Force }
          }
          Expand-Archive -LiteralPath $source -DestinationPath '.' -Force
          Expand-Archive -LiteralPath $kit -DestinationPath '.' -Force
          $harness = 'r06-validation-kit/VERIFY_R06_WINDOWS.ps1'
          $scriptText = Get-Content $harness -Raw
          $scriptText = $scriptText.Replace("session = @(cmd /c 'query session' 2>&1);", "session = @('Windows CI runner: session status is recorded in ci-r06');")
          $scriptText = $scriptText.Replace('for $name: $_', 'for ${name}: $_')
          Set-Content $harness -Value $scriptText -Encoding utf8
          Write-Output 'R06 source and native validation kit extracted after SHA256 verification'
      - name: Verify exact R06 source identity
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          if (!(Test-Path 'RELEASE_STATUS.json')) { throw 'R06 full source not uploaded: RELEASE_STATUS.json missing' }
          $status = Get-Content 'RELEASE_STATUS.json' -Raw | ConvertFrom-Json
          if ($status.source_version -ne '1.7.0' -or $status.source_revision -ne 'V170_R06_LIGHT_DARK_SHELL_BUTTON_FINISH') {
            throw "Wrong baseline: version=$($status.source_version) revision=$($status.source_revision); refused to test older source"
          }
          if (!(Test-Path 'r06-validation-kit/VERIFY_R06_WINDOWS.ps1')) { throw 'R06 Windows verification kit missing' }
          if (!(Test-Path 'source/tests/UiSmokeTests/UiSmokeTests.csproj')) { throw 'UiSmokeTests source missing' }
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Capture Windows environment
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force ci-r06 | Out-Null
          dotnet --info | Out-File ci-r06/dotnet-info.log
          [Environment]::UserInteractive | Out-File ci-r06/user-interactive.txt
          'Hosted Windows runner: native session query may not be available.' | Out-File ci-r06/sessions.txt
      - name: Run Python source and product tests
        shell: pwsh
        run: |
          python -m unittest discover -s source/tests -p 'test_*.py' -q 2>&1 | Tee-Object ci-r06/source-tests.log
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          python -m unittest discover -s tests -p 'test_*.py' -q 2>&1 | Tee-Object ci-r06/product-tests.log
          exit $LASTEXITCODE
      - name: Compile R06 WPF and native test host
        shell: pwsh
        run: |
          dotnet build source/tests/UiSmokeTests/UiSmokeTests.csproj -c Release -warnaserror 2>&1 | Tee-Object ci-r06/wpf-compile.log
          exit $LASTEXITCODE
      - name: Run real Windows UI interactions and screenshots
        shell: pwsh
        timeout-minutes: 18
        run: |
          powershell -NoProfile -ExecutionPolicy Bypass -File .\r06-validation-kit\VERIFY_R06_WINDOWS.ps1 -IncludeExtendedUI 2>&1 | Tee-Object ci-r06/windows-visual.log
          exit $LASTEXITCODE
      - name: Preserve native Windows evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: sunrise-file-manager-r06-windows-evidence
          path: |
            ci-r06/
            validation/windows-r06-visual-*/
          if-no-files-found: warn
          retention-days: 14
