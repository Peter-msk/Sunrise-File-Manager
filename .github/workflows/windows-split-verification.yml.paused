name: Windows WPF EIASS verification
on:
  push:
    branches: [codex/verify-1.5.3-eiass]
permissions:
  contents: read
jobs:
  wpf-ui:
    runs-on: windows-2025
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Display environment
        shell: pwsh
        run: |
          if (Get-Command Set-DisplayResolution -ErrorAction SilentlyContinue) {
            Set-DisplayResolution -Width 1920 -Height 1080 -Force
          }
          dotnet --info
          query session
          exit 0
      - name: Build product and WPF verification host
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force windows-ui-evidence | Out-Null
          dotnet build source/tests/UiSmokeTests/UiSmokeTests.csproj --configuration Release -warnaserror 2>&1 | Tee-Object windows-ui-evidence/build.log
          exit $LASTEXITCODE
      - name: Run Windows WPF EIASS rename and undo interactions
        timeout-minutes: 5
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force windows-ui-evidence | Out-Null
          dotnet run --project source/tests/UiSmokeTests/UiSmokeTests.csproj --configuration Release --no-build -- --eiass-rename-only windows-ui-evidence 2>&1 | Tee-Object windows-ui-evidence/execution.log
          $testExit = $LASTEXITCODE
          if (Test-Path windows-ui-evidence/UI_RESULT.json) {
            Get-Content windows-ui-evidence/UI_RESULT.json
          } else {
            throw 'UI result was not produced.'
          }
          exit $testExit
      - name: Save execution evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: windows-eiass-ui-evidence
          path: windows-ui-evidence
          retention-days: 14
