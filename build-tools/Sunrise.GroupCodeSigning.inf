; Sunrise File Manager - self-signed BUILD certificate template.
; Processed only by Windows certreq.exe during build. No PFX is produced.
; The self-signed publisher is NOT a publicly trusted identity.
[Version]
Signature = "$Windows NT$"

[NewRequest]
Subject = "CN=Sunrise Group"
FriendlyName = "Sunrise Group - Sunrise File Manager Build Signing"
RequestType = Cert
MachineKeySet = FALSE
Exportable = FALSE
KeyAlgorithm = RSA
KeyLength = 3072
ProviderName = "Microsoft Software Key Storage Provider"
HashAlgorithm = sha256
KeyUsage = 0x80
KeyUsageProperty = 0x2
ValidityPeriod = Years
ValidityPeriodUnits = 3
Silent = TRUE

[Extensions]
2.5.29.37 = "{text}1.3.6.1.5.5.7.3.3"
