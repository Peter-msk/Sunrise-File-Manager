<Window x:Class="Sunrise.FileManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sunrise.FileManager.Controls"
 Style="{StaticResource AppWindow}" Title="Sunrise File Manager 1.5.3" Width="1520" Height="930" MinWidth="1010" MinHeight="560" WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="56"/><RowDefinition x:Name="TransferToolbarRow" Height="0"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="14,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
     <Border Background="{DynamicResource Brand}" Width="30" Height="30" CornerRadius="6" Margin="0,0,10,0"><Path Fill="{DynamicResource ThemeFolderIcon}" Stretch="Uniform" Margin="6" Data="M0,2 L6,2 9,5 20,5 20,17 0,17 Z"/></Border>
     <TextBlock Text="Sunrise File Manager" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
     <ComboBox x:Name="UiScaleSelector" Width="84" Margin="0,0,6,0" ToolTip="전체 UI 배율 (기본 80%)" SelectionChanged="UiScale_SelectionChanged"/>
     <Button x:Name="HeaderThemeButton" Content="테마" Style="{StaticResource ExplorerCommand}" Click="ThemeCycle_Click"
       ToolTip="테마 순환: PC 설정 적용 → 라이트 → 다크" Margin="0,0,6,0" Padding="10,5"/>
     <Border Background="{DynamicResource ThemeSoftAlt}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="2" Margin="0,0,6,0">
      <StackPanel Orientation="Horizontal">
       <Button x:Name="OneButton" Style="{StaticResource ExplorerToggle}" Content="단일" Click="One_Click" ToolTip="단일 폴더 보기 (Ctrl+1)"/>
       <Button x:Name="TwoButton" Style="{StaticResource ExplorerToggle}" Content="2분할" Click="Two_Click" ToolTip="두 개 탐색기 분할 (Ctrl+2)"/>
       <Button x:Name="ThreeButton" Style="{StaticResource ExplorerToggle}" Content="3분할" Click="Three_Click" ToolTip="세 개 탐색기 분할 (Ctrl+3)"/>
       <Button x:Name="FourButton" Style="{StaticResource ExplorerToggle}" Content="4분할" Click="Four_Click" ToolTip="네 개 탐색기 분할 (Ctrl+4)"/>
      </StackPanel>
     </Border>
     <Button x:Name="AiToggleButton" Style="{StaticResource PrimaryButton}" Content="AI 파일 정리" Click="AiToggle_Click" ToolTip="AI 파일 검색·정리 팝업 열기/닫기 (F8)" Margin="0,0,6,0"/>
     <Menu Style="{StaticResource SunrisePaneMenu}" VerticalAlignment="Center" MinHeight="34">
      <MenuItem Header="설정 · 기능 ▾" Padding="12,7">
       <MenuItem Header="새 독립 창 열기" InputGestureText="Ctrl+Shift+W" Click="NewWindow_Click"/>
       <MenuItem Header="전송 복구 기록 확인…" Click="RecoveryJournal_Click"/>
       <Separator/>
       <MenuItem Header="AI 연결 및 설치" Click="AiConnect_Click"/>
       <Separator/>
       <MenuItem Header="상세정보 · 메모 켜기/끄기" Click="InspectorToggle_Click"/>
       <MenuItem Header="미리보기 켜기/끄기" Click="MainPreview_Click"/>
       <Separator/>
       <MenuItem Header="분할 배치 전환" Click="CycleSplitPreset_Click"/>
       <Separator/>
       <MenuItem Header="화면 테마">
        <MenuItem x:Name="ThemeSystemMenuItem" Header="PC 설정 적용" IsCheckable="True" Click="ThemeSystem_Click"/>
        <MenuItem x:Name="ThemeLightMenuItem" Header="라이트 모드" IsCheckable="True" Click="ThemeLight_Click"/>
        <MenuItem x:Name="ThemeDarkMenuItem" Header="다크 모드" IsCheckable="True" Click="ThemeDark_Click"/>
       </MenuItem>
       <Separator/>
       <MenuItem Header="공지사항 · 버전 정보" Click="Notice_Click"/>
       <MenuItem Header="업데이트 확인" Click="UpdateCheck_Click"/>
      </MenuItem>
     </Menu>
     <!-- Existing named controls remain for code compatibility, but are not part of the title toolbar. -->
     <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
      <ComboBox x:Name="SplitPresetSelector" Width="142" SelectionChanged="SplitPresetSelector_SelectionChanged"/>
      <Button x:Name="CycleSplitPresetButton" Content="배치 전환" Click="CycleSplitPreset_Click"/>
      <Button x:Name="InspectorToggleButton" Content="상세정보 · 메모" Click="InspectorToggle_Click"/>
      <Button x:Name="MainPreviewButton" Content="미리보기" Click="MainPreview_Click"/>
      <Button x:Name="AiConnectButton" Content="AI 연결" Click="AiConnect_Click"/>
      <ComboBox x:Name="ThemeSelector" SelectionChanged="ThemeSelector_SelectionChanged"><ComboBoxItem Content="PC 설정" Tag="System"/><ComboBoxItem Content="라이트" Tag="Light"/><ComboBoxItem Content="다크" Tag="Dark"/></ComboBox>
     </StackPanel>
    </WrapPanel>
   </Grid>
  </Border>
  <Border x:Name="TransferToolbar" Grid.Row="1" Background="{DynamicResource ThemeTransferBar}" Padding="12,4" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Visibility="Collapsed">
   <WrapPanel VerticalAlignment="Center">
    <TextBlock Text="패널 간 빠른 작업 (Q-Dir)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox x:Name="SourceSelector" Width="104" Margin="0,0,6,0"/><TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <ComboBox x:Name="DestinationSelector" Width="104" Margin="0,0,10,0"/>
    <Button x:Name="CopyButton" Content="복사" Click="Copy_Click" Margin="0,0,4,0" ToolTip="원본 창의 선택 항목을 대상 창 폴더로 복사"/>
    <Button x:Name="MoveButton" Content="이동" Click="Move_Click" Margin="0,0,8,0" ToolTip="원본 창의 선택 항목을 대상 창 폴더로 이동"/>
    <ComboBox x:Name="CollisionSelector" Width="134" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="중복: 건너뛰기"/><ComboBoxItem Content="중복: 새 이름"/></ComboBox>
    <Button x:Name="SwapPanesButton" Content="창 맞바꾸기" Click="SwapPanes_Click" Margin="0,0,4,0" ToolTip="원본 창과 대상 창의 작업 폴더·탭 상태를 서로 맞바꿉니다 (Q-Dir 스왑)"/>
    <Button x:Name="SyncPanesButton" Content="폴더 동기화" Click="SyncPanes_Click" Margin="0,0,12,0" ToolTip="모든 분할 창을 현재 활성 창의 작업 폴더 경로로 동기화합니다"/>
    <TextBlock Text="동일 드라이브 드래그: 이동 · Ctrl+드래그: 복사 · 분할 변경 시 작업 폴더 자동 보존" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
   </WrapPanel>
  </Border>
  <!-- The preview stays in the rightmost column; AI work runs in an independent popup window. -->
  <Grid x:Name="WorkspaceShell" Grid.Row="2" Margin="6" SnapsToDevicePixels="True">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition x:Name="PreviewDividerColumn" Width="0"/>
    <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
   </Grid.ColumnDefinitions>
   <Grid x:Name="FileAreaShell" Grid.Column="0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition x:Name="InspectorDividerColumn" Width="11"/>
     <ColumnDefinition x:Name="InspectorColumn" Width="330"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="WorkspaceViewport" Grid.Row="0" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" SnapsToDevicePixels="True">
     <Grid x:Name="Workspace" Width="800" Height="500"/>
    </ScrollViewer>
    <GridSplitter Style="{StaticResource SunriseVerticalSplitter}" x:Name="InspectorSplitter" Grid.Row="0" Grid.Column="1" Background="{DynamicResource ThemeSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowsPreview="True"/>
    <local:FileInspector x:Name="Inspector" Grid.Row="0" Grid.Column="2"/>
   </Grid>
   <GridSplitter Style="{StaticResource SunriseVerticalSplitter}" x:Name="PreviewColumnSplitter" Grid.Column="1" Background="{DynamicResource ThemeSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowsPreview="True" Visibility="Collapsed"/>
   <local:FilePreviewPanel x:Name="PreviewPane" Grid.Column="2" Visibility="Collapsed"/>
  </Grid>
  <Border Grid.Row="3" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="14,7">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock x:Name="JobStatus" Text="준비됨 · Windows 기본 탐색기 호환 모드" Foreground="{DynamicResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="JobDetail" Visibility="Collapsed" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource TextMuted}"/></StackPanel>
    <ProgressBar x:Name="JobProgress" Visibility="Collapsed" Grid.Column="1" Minimum="0" Maximum="100" Height="7" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <!-- Both former footer commands opened the same Sunrise Control window.
         Keep both settings-menu entry points for keyboard/user workflow compatibility. -->
    <Button Grid.Column="2" Content="공지사항 및 업데이트" Style="{StaticResource ExplorerCommand}"
            Click="Notice_Click" MinHeight="25" Padding="10,3" FontSize="12"
            ToolTip="공지사항, 버전 정보 및 업데이트 확인" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal"><Button x:Name="PauseJobButton" Content="일시 중지" Visibility="Collapsed" Click="PauseJob_Click" Padding="8,2" MinHeight="24" Margin="0,0,4,0"/><Button x:Name="CancelJobButton" Visibility="Collapsed" Grid.Column="3" Content="취소" Click="CancelJob_Click" IsEnabled="False" Padding="8,2" MinHeight="24"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
