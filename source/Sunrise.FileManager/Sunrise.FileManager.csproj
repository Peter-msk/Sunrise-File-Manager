<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sunrise.FileManager</AssemblyName>
    <RootNamespace>Sunrise.FileManager</RootNamespace>
    <Product>Sunrise File Manager</Product>
    <Company>Sunrise Group</Company>
    <Authors>Sunrise Group</Authors>
    <Description>Sunrise File Manager Windows Desktop Application</Description>
    <Copyright>Copyright © 2026 Sunrise Group. All rights reserved.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SunriseFileManager.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/SunriseFileManager.ico" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>
</Project>
