<Window x:Class="Sunrise.FileManager.Controls.CloudDriveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Sunrise 클라우드 파일 관리" Width="1040" Height="720" MinWidth="690" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
 <Grid Margin="12" KeyboardNavigation.TabNavigation="Cycle">
  <Grid.Resources>
   <Style x:Key="CloudCenteredColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PopupCenteredColumnHeader}">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
   </Style>
   <Style x:Key="CloudCenteredCell" TargetType="TextBlock" BasedOn="{StaticResource PopupCenteredCellText}">
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="2,0,0,7">
   <TextBlock Text="클라우드 계정 및 원격 파일 관리" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="서비스 선택 → 앱 Client ID 입력 → 공식 로그인 → 파일 선택 후 작업" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
   <TextBlock Text="계정 비밀번호는 Sunrise에 입력하지 않습니다. 발급 방법은 Client ID 옆 ? 버튼에서 확인하세요." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
  </StackPanel>
  <!-- R61: Account connection is distinct from remote navigation and file operations. -->
  <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="9" Background="{DynamicResource ThemeSurface}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="연결 설정" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="1" Grid.Column="0" Text="연결할 서비스" VerticalAlignment="Center"/>
    <ComboBox AutomationProperties.Name="클라우드 서비스 선택" x:Name="ProviderSelector" Grid.Row="1" Grid.Column="1" Margin="0,0,10,5" SelectionChanged="ProviderSelector_SelectionChanged">
     <ComboBoxItem Content="Google Drive" Tag="GoogleDrive"/>
     <ComboBoxItem Content="OneDrive" Tag="OneDrive"/>
    </ComboBox>
    <TextBlock Grid.Row="1" Grid.Column="2" Text="앱 Client ID*" VerticalAlignment="Center"/>
    <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,0,5">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Grid.Column="0" AutomationProperties.Name="OAuth 애플리케이션 Client ID" x:Name="ClientIdBox" VerticalContentAlignment="Center" ToolTip="Google Cloud / Microsoft Entra 공식 앱 등록 Client ID (비밀번호 아님)"/>
     <Button Grid.Column="1" x:Name="ClientIdHelpButton" Content="?" Click="ClientIdHelp_Click" MinWidth="32" Padding="7,3" Margin="5,0,0,0" FontWeight="Bold" AutomationProperties.Name="선택한 드라이브의 앱 Client ID 발급 방법" ToolTip="선택한 서비스의 공식 Client ID 발급 방법 보기"/>
    </Grid>
    <TextBlock Grid.Row="2" Grid.Column="0" Text="테넌트(선택)" VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="OneDrive 테넌트" x:Name="TenantBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,4" ToolTip="OneDrive만 해당. 비우면 common"/>
    <CheckBox x:Name="RememberSignInBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,0,0,4"
              Content="자동 로그인 (암호화된 갱신 토큰 저장)" Checked="RememberSignIn_Changed" Unchecked="RememberSignIn_Changed"/>
    <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0" KeyboardNavigation.TabNavigation="Continue">
     <Button x:Name="ConnectButton" Content="공식 로그인으로 연결" Click="Connect_Click" Padding="12,5" Margin="0,0,8,0"/>
     <Button x:Name="DisconnectButton" Content="계정 연결 해제" Click="Disconnect_Click" Padding="12,5" Margin="0,0,8,0"/>
    </WrapPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,6,0,6" KeyboardNavigation.TabNavigation="Continue">
   <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,5">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
      <TextBlock Text="원격 탐색" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0"/>
      <Button x:Name="UpButton" Content="상위 폴더" Click="Up_Click" Padding="9,4" Margin="0,0,5,0"/>
      <Button x:Name="RefreshButton" Content="새로고침" Click="Refresh_Click" Padding="9,4" Margin="0,0,5,0"/>
     </StackPanel>
     <TextBlock x:Name="FolderLocationText" Text="계정을 연결하면 원격 폴더가 표시됩니다" VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="현재 클라우드 폴더"/>
    </DockPanel>
   </Border>
   <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="7">
    <StackPanel>
     <TextBlock Text="파일 작업" FontWeight="SemiBold" Margin="0,0,0,3"/>
     <WrapPanel x:Name="CloudFileActions" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue">
      <Button x:Name="UploadButton" Content="업로드" Click="Upload_Click" Padding="9,4" Margin="0,1,5,1" ToolTip="로컬 파일을 현재 클라우드 폴더에 업로드합니다. 같은 이름 덮어쓰기 금지"/>
      <Button x:Name="DownloadButton" Content="다운로드" Click="Download_Click" Padding="9,4" Margin="0,1,5,1" ToolTip="선택한 클라우드 파일을 로컬 폴더에 안전하게 내려받습니다"/>
      <Button x:Name="NewFolderButton" Content="새 폴더" Click="NewFolder_Click" Padding="9,4" Margin="0,1,5,1"/>
      <Button x:Name="RenameButton" Content="이름 변경" Click="Rename_Click" Padding="9,4" Margin="0,1,5,1"/>
      <Button x:Name="CopyButton" Content="현재 폴더에 복사" Click="Copy_Click" Padding="9,4" Margin="0,1,5,1"/>
      <Button x:Name="TrashButton" Content="휴지통으로 이동" Click="Trash_Click" Padding="9,4" Margin="0,1,5,1" AutomationProperties.HelpText="사용자 확인 후 공급자 휴지통으로 이동합니다"/>
     </WrapPanel>
    </StackPanel>
   </Border>
  </StackPanel>
  <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Background="{DynamicResource ThemeSurface}">
   <DataGrid Style="{StaticResource PopupResultDataGrid}" AutomationProperties.Name="클라우드 파일 및 폴더 목록" x:Name="RemoteFilesGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
             SelectionMode="Single" MouseDoubleClick="RemoteFilesGrid_DoubleClick" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource TextPrimary}" RowHeight="32" ColumnHeaderHeight="36" ColumnHeaderStyle="{StaticResource CloudCenteredColumnHeader}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="파일 및 폴더" ElementStyle="{StaticResource CloudCenteredCell}" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="구분" ElementStyle="{StaticResource CloudCenteredCell}" Binding="{Binding TypeLabel}" Width="120"/>
     <DataGridTextColumn Header="크기" ElementStyle="{StaticResource CloudCenteredCell}" Binding="{Binding SizeLabel}" Width="120"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <StackPanel Grid.Row="4" Margin="2,9,0,0">
   <ProgressBar x:Name="TransferProgressBar" Minimum="0" Maximum="100" Height="6" Visibility="Collapsed" Margin="0,0,0,6"/>
   <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Text="계정 연결을 선택하세요." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
  </StackPanel>
 </Grid>
</Window>
