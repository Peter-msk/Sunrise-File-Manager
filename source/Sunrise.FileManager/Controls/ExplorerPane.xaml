<UserControl x:Class="Sunrise.FileManager.Controls.ExplorerPane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sunrise.FileManager.Controls" MinWidth="330" MinHeight="230" Foreground="{DynamicResource TextPrimary}" PreviewKeyDown="ExplorerPane_PreviewKeyDown" PreviewMouseDown="ExplorerPane_PreviewMouseDown">
 <Border Margin="2" BorderThickness="1" Background="{DynamicResource ThemeSurface}" CornerRadius="3">
  <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition x:Name="AddressRow" Height="42"/><RowDefinition x:Name="BreadcrumbRow" Height="28"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>



   <!-- Row 0: Classic Windows menu for each split pane -->
   <Menu Grid.Row="0" Style="{StaticResource SunrisePaneMenu}" BorderThickness="0,0,0,1" Padding="2,0">
    <MenuItem Header="파일(_F)">
     <MenuItem Header="새 탭 열기" InputGestureText="Ctrl+T" Click="NewTab_Click"/>
     <Separator/>
     <MenuItem Header="새 폴더" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click"/>
     <MenuItem Header="새 파일" InputGestureText="Ctrl+N" Click="NewFile_Click"/>
     <Separator/>
     <MenuItem Header="열기" InputGestureText="Enter" Click="ContextOpen_Click"/>
     <MenuItem Header="연결 프로그램 선택" Click="ContextOpenWith_Click"/>
     <Separator/>
     <MenuItem Header="CMD에서 열기" Click="OpenCmd_Click"/>
     <MenuItem Header="Windows 탐색기에서 열기" Click="OpenWindowsExplorer_Click"/>
    </MenuItem>
    <MenuItem Header="편집(_E)">
     <MenuItem Header="실행 취소" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
     <MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
     <Separator/>
     <MenuItem Header="잘라내기" InputGestureText="Ctrl+X" Click="ClipboardCut_Click"/>
     <MenuItem Header="복사" InputGestureText="Ctrl+C" Click="ClipboardCopy_Click"/>
     <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Click="ClipboardPaste_Click"/>
     <MenuItem Header="이름 바꾸기" InputGestureText="F2" Click="Rename_Click"/>
     <MenuItem Header="복제" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
     <Separator/>
     <MenuItem Header="삭제" InputGestureText="Delete" Click="Recycle_Click"/>
     <MenuItem Header="영구 삭제" InputGestureText="Shift+Delete" Click="PermanentDelete_Click"/>
     <Separator/>
     <MenuItem Header="모두 선택" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
    </MenuItem>
    <MenuItem Header="보기(_V)">
     <MenuItem Header="새로 고침" InputGestureText="F5" Click="Refresh_Click"/>
     <Separator/>
     <MenuItem Header="탐색 창 켜기/끄기" Click="TreeToggle_Click"/>
     <MenuItem Header="상세 정보 켜기/끄기" Click="DetailsToggle_Click"/>
     <MenuItem Header="미리보기 켜기/끄기" Click="PreviewToggle_Click"/>
     <Separator/>
     <!-- R12: view/filter controls stay accessible when compact panes hide the toolbar combos -->
     <MenuItem Header="표시 방식">
      <MenuItem Header="자세히" Tag="0" Click="ViewModeMenu_Click"/>
      <MenuItem Header="목록" Tag="1" Click="ViewModeMenu_Click"/>
      <MenuItem Header="큰 아이콘" Tag="2" Click="ViewModeMenu_Click"/>
      <MenuItem Header="작은 아이콘" Tag="3" Click="ViewModeMenu_Click"/>
      <MenuItem Header="타일" Tag="4" Click="ViewModeMenu_Click"/>
     </MenuItem>
     <MenuItem Header="파일 유형 필터">
      <MenuItem Header="전체 항목" Tag="0" Click="CategoryMenu_Click"/>
      <MenuItem Header="폴더만" Tag="1" Click="CategoryMenu_Click"/>
      <MenuItem Header="문서" Tag="2" Click="CategoryMenu_Click"/>
      <MenuItem Header="이미지" Tag="3" Click="CategoryMenu_Click"/>
      <MenuItem Header="동영상" Tag="4" Click="CategoryMenu_Click"/>
      <MenuItem Header="오디오" Tag="5" Click="CategoryMenu_Click"/>
      <MenuItem Header="압축파일" Tag="6" Click="CategoryMenu_Click"/>
      <MenuItem Header="메모 있음" Tag="7" Click="CategoryMenu_Click"/>
     </MenuItem>
     <!-- Remains available while R17 compact layouts hide the quick display options. -->
     <MenuItem Header="표시 항목">
      <MenuItem Header="숨긴 항목 표시 켜기/끄기" Click="ToggleHiddenMenu_Click"/>
      <MenuItem Header="파일 확장명 표시 켜기/끄기" Click="ToggleExtensionsMenu_Click"/>
      <MenuItem Header="항목 확인란 켜기/끄기" Click="ToggleCheckboxesMenu_Click"/>
      <MenuItem Header="색상 구분 켜기/끄기" Click="ToggleColorCodingMenu_Click"/>
     </MenuItem>
    </MenuItem>
    <MenuItem Header="즐겨찾기(_A)">
     <MenuItem Header="현재 폴더 고정" Click="ContextPinFolder_Click"/>
    </MenuItem>
    <MenuItem Header="추가 기능(_X)">
     <MenuItem Header="ZIP 압축" Click="ZipCompress_Click"/>
     <MenuItem Header="ZIP 압축 풀기" Click="ZipExtract_Click"/>
     <MenuItem Header="목록 내보내기" Click="ExportList_Click"/>
    </MenuItem>
    <MenuItem Header="정보(_I)">
     <MenuItem Header="속성" InputGestureText="Alt+Enter" Click="ContextProperties_Click"/>
    </MenuItem>
   </Menu>

   <!-- Row 1: Windows 11 Style Top Folder Tab Bar -->
   <Grid Grid.Row="1" Background="{DynamicResource ThemeTab}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="PaneTitle" Text="탐색기" FontSize="11" ToolTip="현재 탐색기 분할 창" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,10,0"/>
    <ScrollViewer x:Name="TabScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Tabs_PreviewMouseWheel" ToolTip="마우스 휠로 탭을 좌우로 이동합니다. (Ctrl+T: 새 탭, Ctrl+W: 탭 닫기)">
     <ItemsControl x:Name="TabStrip"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border x:Name="TabSurface" Background="{DynamicResource ThemeTabInactive}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,1,0" Margin="0,4,2,0" CornerRadius="4,4,0,0">
        <StackPanel Orientation="Horizontal"><Button Content="{Binding Title}" Tag="{Binding}" Click="SelectTab_Click" Background="Transparent" Padding="10,4" MaxWidth="240" ToolTip="{Binding CurrentPath}"/><Button Content="×" Tag="{Binding}" Click="CloseTab_Click" Padding="6,2" ToolTip="탭 닫기 (Ctrl+W)"/></StackPanel>
       </Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThemeSurface}"/></DataTrigger></DataTemplate.Triggers>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <Button Style="{StaticResource ExplorerNavButton}" Grid.Column="2" Content="+" Click="NewTab_Click" ToolTip="새 탭 열기 (Ctrl+T)" FontSize="18" Padding="0"/>
    <TextBlock Grid.Column="3" x:Name="PaneStatus" MaxWidth="175" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="6,0,8,0"/>
   </Grid>

   <!-- Row 1: Windows Explorer Navigation Buttons (← → ↑ ⟳), Address Bar, and Search Box -->
   <Grid Grid.Row="2" Margin="8,4">
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition x:Name="SearchColumn" Width="230"/></Grid.ColumnDefinitions>
    <Button Style="{StaticResource ExplorerNavButton}" Grid.Column="0" x:Name="BackButton" Content="←" Click="Back_Click" Padding="0" ToolTip="뒤로 (Alt+Left / Backspace / 마우스 뒤로 버튼)"/>
    <Button Style="{StaticResource ExplorerNavButton}" Grid.Column="1" x:Name="ForwardButton" Content="→" Click="Forward_Click" Padding="0" ToolTip="앞으로 (Alt+Right / 마우스 앞으로 버튼)"/>
    <Button Style="{StaticResource ExplorerNavButton}" Grid.Column="2" x:Name="UpButton" Content="↑" Click="Up_Click" Padding="0" ToolTip="상위 폴더로 이동 (Alt+Up)"/>
    <Button Style="{StaticResource ExplorerNavButton}" Grid.Column="3" Content="⟳" Click="Refresh_Click" Padding="0" ToolTip="새로 고침 (F5 / Ctrl+R)"/>
    <TextBox Grid.Column="4" x:Name="AddressBox" Height="34" VerticalAlignment="Center" KeyDown="AddressBox_KeyDown" ToolTip="폴더 경로 입력 (Alt+D / Ctrl+L / F4 · %TEMP%, %USERPROFILE% 환경변수 지원)" Margin="6,0,0,0"/>
    <Button Grid.Column="5" Content="이동" Click="Go_Click" Style="{StaticResource ExplorerNavButton}" ToolTip="입력한 경로로 이동 (Enter)"/>
    <Grid x:Name="SearchHost" Grid.Column="6" Margin="8,0,0,0" Height="34">
     <TextBox x:Name="SearchBox" Height="34" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" Padding="9,5" ToolTip="현재 폴더에서 검색 (Ctrl+F / Ctrl+E / F3 · Esc로 초기화)"/>
     <TextBlock Text="현재 폴더에서 검색" Foreground="{DynamicResource TextMuted}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </Grid>

   <!-- Row 2: Interactive Folder Path Breadcrumb (Drag & Drop enabled) + Windows Explorer & Q-Dir Display Options -->
   <Border Grid.Row="3" Background="{DynamicResource ThemeSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,1" Padding="8,2">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Grid.Column="0" Text="폴더 경로:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="2,0,6,0"/>
     <ScrollViewer x:Name="BreadcrumbScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Breadcrumb_PreviewMouseWheel" ToolTip="마우스 휠로 긴 폴더 경로를 좌우로 스크롤합니다">
      <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
     </ScrollViewer>
     <StackPanel x:Name="DisplayOptionsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
      <TextBlock Text="표시:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <CheckBox x:Name="HiddenToggle" Content="숨긴 항목" IsChecked="True" Checked="ViewOption_Changed" Unchecked="ViewOption_Changed" FontSize="11" Margin="0,0,8,0" ToolTip="Windows 탐색기 보기 → 표시 → 숨긴 항목"/>
      <CheckBox x:Name="ExtensionsToggle" Content="파일 확장명" IsChecked="True" Checked="ViewOption_Changed" Unchecked="ViewOption_Changed" FontSize="11" Margin="0,0,8,0" ToolTip="Windows 탐색기 보기 → 표시 → 파일 이름 확장명"/>
      <CheckBox x:Name="CheckboxesToggle" Content="항목 확인란" IsChecked="False" Checked="ViewOption_Changed" Unchecked="ViewOption_Changed" FontSize="11" Margin="0,0,8,0" ToolTip="Windows 탐색기 보기 → 표시 → 항목 확인란"/>
      <CheckBox x:Name="ColorFilterToggle" Content="색상 구분" IsChecked="True" Checked="ViewOption_Changed" Unchecked="ViewOption_Changed" FontSize="11" ToolTip="확장자·유형별 파일 이름 색상 강조 표시"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- Retired visual command row: actions remain available through menus/keyboard.
        The hidden named controls preserve existing view/clipboard command bindings.
        Windows 11 File Explorer Standard Command Bar (+ 새로 만들기 | 잘라내기 · 복사 · 붙여넣기 · 이름 바꾸기 · 삭제 · 실행취소 | 정렬/필터 · 보기 | 압축/목록내보내기/도구 | 창 표시) -->
   <ToolBar Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="5,2" FontSize="12" ToolBarTray.IsLocked="True">
    <ToolBar.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource ThemeSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
      <Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="9,4"/><Setter Property="MinHeight" Value="32"/>
     </Style></ToolBar.Resources>
    <!-- 1. Windows Explorer '+ 새로 만들기' Group -->
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="NewFolderButton" Content="+ 폴더" Click="NewFolder_Click" FontWeight="SemiBold" ToolTip="새 폴더 만들기 (Ctrl+Shift+N · 자동 연번 지원)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="NewFileButton" Content="+ 파일" Click="NewFile_Click" ToolTip="새 문서/파일 만들기 (Ctrl+N · 자동 연번 지원)"/>
    <Separator/>
    <!-- 2. Windows Explorer Standard Clipboard & Core Edit Icons (Cut, Copy, Paste, Rename, Duplicate, Delete, Undo/Redo) -->
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="CutSelectionButton" Content="잘라내기" Click="ClipboardCut_Click" ToolTip="선택 항목 잘라내기 (Ctrl+X · 반투명 표시)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="CopySelectionButton" Content="복사" Click="ClipboardCopy_Click" ToolTip="선택 항목 복사 (Ctrl+C)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="PasteSelectionButton" Content="붙여넣기" Click="ClipboardPaste_Click" ToolTip="클립보드 항목 붙여넣기 (Ctrl+V · 동일 폴더 내 사본 자동 생성)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="RenameButton" Content="이름 변경" Click="Rename_Click" ToolTip="이름 바꾸기 · 다중 선택 시 일괄 이름 바꾸기 (F2)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="DuplicateButton" Visibility="Collapsed" Content="⧉ 복제" Click="Duplicate_Click" ToolTip="선택 항목 즉시 사본 생성 (Ctrl+D)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="RecycleButton" Content="삭제" Click="Recycle_Click" ToolTip="휴지통으로 이동 (Delete) · 영구 삭제는 Shift+Delete"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="UndoButton" Visibility="Collapsed" Content="↶ 실행 취소" Click="Undo_Click" IsEnabled="False" ToolTip="최근 이름 변경·이동·생성·복제 실행 취소 (Ctrl+Z)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="RedoButton" Visibility="Collapsed" Content="↷ 다시 실행" Click="Redo_Click" IsEnabled="False" ToolTip="실행 취소한 작업 다시 실행 (Ctrl+Y)"/>
    <Separator/>
    <!-- 3. Windows Explorer '정렬 · 필터' & '보기' Group -->
    <ComboBox x:Name="CategorySelector" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeInputBorder}" FontSize="12" SelectionChanged="CategorySelector_SelectionChanged" Width="96" ToolTip="파일 유형별 필터" Margin="2,0">
     <ComboBoxItem Content="전체 항목" Tag="All"/>
     <ComboBoxItem Content="폴더만" Tag="Folder"/>
     <ComboBoxItem Content="문서" Tag="문서"/>
     <ComboBoxItem Content="이미지" Tag="이미지"/>
     <ComboBoxItem Content="동영상" Tag="동영상"/>
     <ComboBoxItem Content="오디오" Tag="오디오"/>
     <ComboBoxItem Content="압축파일" Tag="압축파일"/>
     <ComboBoxItem Content="메모 있음" Tag="Memo"/>
    </ComboBox>
    <ComboBox x:Name="ViewSelector" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeInputBorder}" FontSize="12" SelectionChanged="ViewSelector_SelectionChanged" Width="94" ToolTip="보기 레이아웃 선택 (자세히 / 목록 / 큰 아이콘 / 작은 아이콘 / 타일 · Ctrl+마우스 휠)">
     <ComboBoxItem Content="자세히"/><ComboBoxItem Content="목록"/><ComboBoxItem Content="큰 아이콘"/><ComboBoxItem Content="작은 아이콘"/><ComboBoxItem Content="타일"/>
    </ComboBox>
    <Separator/>
    <!-- 4. Windows Shell, Archive & Q-Dir Export Utilities -->
    <Button Foreground="{DynamicResource TextPrimary}" Content="↗ 열기" Click="ContextOpen_Click" ToolTip="Windows 기본 연결 앱에서 열기 (Enter)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="ZipCompressButton" Visibility="Collapsed" Content="📦 압축" Click="ZipCompress_Click" ToolTip="선택 항목을 ZIP 압축 파일로 묶기"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="ZipExtractButton" Visibility="Collapsed" Content="📂 압축풀기" Click="ZipExtract_Click" ToolTip="선택한 ZIP 압축 파일 풀기"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="ExportListButton" Visibility="Collapsed" Content="📋 목록 내보내기" Click="ExportList_Click" ToolTip="현재 폴더 파일 목록을 CSV로 저장하거나 클립보드로 복사"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="OpenCmdButton" Visibility="Collapsed" Content="⌨ CMD" Click="OpenCmd_Click" ToolTip="현재 폴더 경로에서 명령 프롬프트(cmd.exe) 열기"/>
    <Separator/>
    <!-- 5. Windows Explorer Pane Toggles (탐색 창 · 세부 정보 창 · 미리보기 창) -->
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="TreeToggle" Visibility="Collapsed" Content="◧ 탐색 창" Click="TreeToggle_Click" ToolTip="좌측 폴더 탐색 트리 표시/숨김"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="DetailsToggle" Visibility="Collapsed" Content="ⓘ 세부 정보" Click="DetailsToggle_Click" ToolTip="세부 정보 및 #memo 창 표시/숨김 (Alt+Shift+P)"/>
    <Button Foreground="{DynamicResource TextPrimary}" x:Name="PreviewToggle" Visibility="Collapsed" Content="◨ 미리보기" Click="PreviewToggle_Click" ToolTip="우측 독립 미리보기 창 표시/숨김 (Alt+P / Space)"/>
   </ToolBar>

   <!-- File navigation: reclaimed command-bar height -->
   <Grid Grid.Row="4">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="215"/><ColumnDefinition x:Name="TreeDividerColumn" Width="6"/><ColumnDefinition Width="*" MinWidth="100"/><ColumnDefinition x:Name="DetailsDividerColumn" Width="1"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
    <local:FolderTree Grid.Column="0" x:Name="NavigationTree"/>
    <GridSplitter Grid.Column="1" x:Name="TreeDivider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource PanelBorder}"/>
    <DataGrid Grid.Column="2" x:Name="FilesGrid" MinColumnWidth="46" Margin="5,0,5,0" FontSize="13" SelectionMode="Extended" CanUserResizeColumns="True"
              EnableRowVirtualization="True" EnableColumnVirtualization="True"
              VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="FilesGrid_SelectionChanged"
              MouseDoubleClick="FilesGrid_MouseDoubleClick" Sorting="FilesGrid_Sorting"
              LoadingRow="FilesGrid_LoadingRow" PreviewMouseRightButtonDown="FilesGrid_PreviewMouseRightButtonDown"
              PreviewMouseWheel="FilesGrid_PreviewMouseWheel"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              AllowDrop="True" PreviewDragOver="FilesGrid_PreviewDragOver" PreviewDrop="FilesGrid_PreviewDrop"
              DragLeave="FilesGrid_DragLeave" PreviewMouseLeftButtonDown="FilesGrid_PreviewMouseLeftButtonDown"
              PreviewMouseMove="FilesGrid_PreviewMouseMove" PreviewKeyDown="FilesGrid_PreviewKeyDown">
     <DataGrid.ContextMenu>
      <ContextMenu>
       <ContextMenu.Resources>
        <Style TargetType="MenuItem" BasedOn="{StaticResource CompactContextMenuItem}"/>
        <Style TargetType="Separator" BasedOn="{StaticResource CompactContextSeparator}"/>
       </ContextMenu.Resources>
       <MenuItem Header="연결 앱에서 원본 열기" InputGestureText="Enter" Click="ContextOpen_Click"/>
       <MenuItem Header="연결 프로그램 선택…" Click="ContextOpenWith_Click"/>
       <MenuItem Header="새 탭에서 폴더 열기" InputGestureText="Ctrl+T" Click="ContextOpenInNewTab_Click"/>
       <MenuItem Header="우측 미리보기 켜기/끄기" InputGestureText="Alt+P / Space" Click="PreviewToggle_Click"/>
       <MenuItem Header="🤖 선택 항목 온보드 AI 정리 / 요약 (F8)" Click="SendToAi_Click"/>
       <MenuItem Header="즐겨찾기(빠른 이동)에 고정" Click="ContextPinFolder_Click"/>
       <Separator/>
       <MenuItem Header="실행 취소" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
       <MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
       <MenuItem Header="잘라내기" InputGestureText="Ctrl+X" Click="ClipboardCut_Click"/>
       <MenuItem Header="복사" InputGestureText="Ctrl+C" Click="ClipboardCopy_Click"/>
       <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Click="ClipboardPaste_Click"/>
       <MenuItem Header="사본 만들기 (복제)" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
       <Separator/>
       <MenuItem Header="새로 만들기 → 폴더" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click"/>
       <MenuItem Header="새로 만들기 → 텍스트/문서 파일…" InputGestureText="Ctrl+N" Click="NewFile_Click"/>
       <MenuItem Header="이름 바꾸기 / 일괄 이름 바꾸기" InputGestureText="F2" Click="Rename_Click"/>
       <Separator/>
       <MenuItem Header="ZIP으로 압축하기…" Click="ZipCompress_Click"/>
       <MenuItem Header="여기에 ZIP 압축 풀기" Click="ZipExtract_Click"/>
       <MenuItem Header="현재 폴더 목록 내보내기 (CSV / 클립보드)" Click="ExportList_Click"/>
       <Separator/>
       <MenuItem Header="삭제 (휴지통으로 이동)" InputGestureText="Delete" Click="Recycle_Click"/>
       <MenuItem Header="영구 삭제 (복원 불가)" InputGestureText="Shift+Delete" Click="PermanentDelete_Click"/>
       <Separator/>
       <MenuItem Header="모두 선택" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
       <MenuItem Header="선택 반전" Click="InvertSelection_Click"/>
       <Separator/>
       <MenuItem Header="터미널(CMD)에서 열기" Click="OpenCmd_Click"/>
       <MenuItem Header="Windows 기본 파일 탐색기에서 열기" Click="OpenWindowsExplorer_Click"/>
       <MenuItem Header="경로로 복사" InputGestureText="Ctrl+Shift+C" Click="ContextCopyPath_Click"/>
       <MenuItem Header="파일 이름 복사" Click="ContextCopyName_Click"/>
       <MenuItem Header="속성" InputGestureText="Alt+Enter" Click="ContextProperties_Click"/>
      </ContextMenu>
     </DataGrid.ContextMenu>
     <DataGrid.Columns>
      <DataGridTemplateColumn Header=" " Width="42" CanUserSort="False">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding DataContext.CheckboxesVisibility, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=Collapsed}"
                    Click="ItemCheckBox_Click" Margin="0,0,4,0" VerticalAlignment="Center"/>
          <Grid Opacity="{Binding RowOpacity}">
           <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FileIconTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <Image Source="{Binding ThumbnailSource}" Stretch="Uniform" Margin="2"/>
          </Grid>
         </StackPanel>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="이름" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="2*" MinWidth="190">
       <DataGridTextColumn.ElementStyle>
        <Style TargetType="TextBlock">
         <Setter Property="Foreground" Value="{Binding NameForeground}"/>
         <Setter Property="VerticalAlignment" Value="Center"/>
         <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
         <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
        </Style>
       </DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
      <DataGridTextColumn Header="수정한 날짜" Binding="{Binding ModifiedDisplay}" SortMemberPath="ModifiedAt" Width="152" />
      <DataGridTextColumn Header="유형" Binding="{Binding TypeName}" SortMemberPath="TypeName" Width="112" />
      <DataGridTextColumn Header="크기" Binding="{Binding SizeDisplay}" SortMemberPath="SizeBytes" Width="90" />
      <DataGridTextColumn Header="메모" Binding="{Binding MemoBadge}" SortMemberPath="HasMemo" Width="62" />
      <DataGridTextColumn Header="만든 날짜" Binding="{Binding CreatedDisplay}" SortMemberPath="CreatedAt" Width="152" />
     </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Column="3" x:Name="DetailsDivider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource PanelBorder}"/>
    <Border Grid.Column="4" x:Name="DetailsPanel" Background="{DynamicResource ThemeStatus}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0" Padding="16">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="상세 정보" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <TextBlock x:Name="DetailsName" Text="파일을 선택하세요" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <TextBlock x:Name="DetailsMeta" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
      <Separator Margin="0,16"/><TextBlock x:Name="DetailsSummary" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
      <Button Content="연결 앱에서 원본 열기" Click="ContextOpen_Click" BorderBrush="{DynamicResource PanelBorder}" Margin="0,18,0,6"/>
      <Button Content="우측 미리보기" Click="PreviewToggle_Click" BorderBrush="{DynamicResource PanelBorder}"/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>

   <!-- File Explorer Status Bar -->
   <Border Grid.Row="5" Background="{DynamicResource ThemeStatus}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="10,5">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Grid.Column="0" x:Name="FooterText" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" x:Name="DriveSpaceText" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </Grid>
 </Border>
</UserControl>
