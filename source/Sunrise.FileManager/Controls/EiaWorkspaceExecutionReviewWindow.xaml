<Window x:Class="Sunrise.FileManager.Controls.EiaWorkspaceExecutionReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="사업별 폴더 생성 준비 검토 · DEV26 (실행 금지)"
        Width="1040" Height="690" MinWidth="790" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
 <Grid Margin="13">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
          Background="{DynamicResource ThemeSurface}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
   <StackPanel>
    <TextBlock Text="자동 폴더 생성 사전 검토 및 재점검 (읽기 전용)" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Text="회사 표준 승인 폴더 트리는 사용하지 않습니다. Windows/NTFS/ACL/NAS 검증과 운영용 생성 기능은 미완료이며 이 화면은 쓰기 권한을 부여하지 않습니다."
               Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
    <TextBlock Text="표시된 상태는 직전 읽기 전용 점검 당시의 관찰 결과입니다. 실제 생성 전에는 새로운 재점검과 별도 사용자 승인이 필요합니다."
               Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1" Margin="0,0,0,8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Grid.Row="0" Grid.Column="0" Text="검토 범위" Margin="5,3,10,3"/>
   <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceLabel}" Margin="0,3"/>
   <TextBlock Grid.Row="1" Grid.Column="0" Text="사업 경로" Margin="5,3,10,3"/>
   <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkspacePath}" IsReadOnly="True"
            BorderThickness="0" Background="Transparent" Margin="0,3" AutomationProperties.Name="검토 대상 폴더 경로 읽기 전용"/>
   <TextBlock Grid.Row="2" Grid.Column="0" Text="경로 관찰 지문" Margin="5,3,10,3"/>
   <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StrictPlanFingerprintSha256}" IsReadOnly="True"
            BorderThickness="0" Background="Transparent" Margin="0,3" AutomationProperties.Name="생성 준비 검토 경로 지문 읽기 전용"/>
   <TextBlock Grid.Row="3" Grid.Column="0" Text="검토 당시 집계" Margin="5,3,10,3"/>
   <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
    <TextBlock Text="기존 " />
    <TextBlock Text="{Binding Existing}" FontWeight="SemiBold"/>
    <TextBlock Text=" · 생성 예상 " />
    <TextBlock Text="{Binding Missing}" FontWeight="SemiBold"/>
    <TextBlock Text=" · 차단 " />
    <TextBlock Text="{Binding Blocked}" FontWeight="SemiBold"/>
    <TextBlock Text=" · 실제 생성 0" FontWeight="SemiBold"/>
   </StackPanel>
  </Grid>
  <DataGrid Grid.Row="2" x:Name="ReadinessPathsGrid" ItemsSource="{Binding ObservedPaths}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
            AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
            CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="생성 준비 검토 당시의 경로별 상태표 읽기 전용">
   <DataGrid.Columns>
    <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="95"/>
    <DataGridTextColumn Header="범위" Binding="{Binding ScopeLabel}" Width="85"/>
    <DataGridTextColumn Header="상대경로" Binding="{Binding RelativePath}" Width="3*" MinWidth="180"/>
    <DataGridTextColumn Header="진단 원인" Binding="{Binding Detail}" Width="3*" MinWidth="180"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,8,0,0">
   <Grid Margin="0,0,0,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="사업 폴더명 재입력" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBox Grid.Column="1" x:Name="WorkspaceNameConfirmation" MaxLength="220" Margin="0,0,8,0"
             TextChanged="WorkspaceNameConfirmation_TextChanged"
             AutomationProperties.Name="사업 폴더명 검토 확인 입력 (쓰기 권한 아님)"/>
    <Button Grid.Column="2" Content="사업별 검토 확인 (생성 아님)" Click="AcknowledgeProject_Click" Padding="9,5"
            AutomationProperties.Name="사업별 읽기 전용 검토 완료 확인"/>
    <TextBlock Grid.Column="3" x:Name="ProjectReviewStatus" Text="검토 확인은 생성 승인이나 쓰기 권한이 아닙니다."
               Margin="9,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"
               Foreground="{DynamicResource TextMuted}"/>
   </Grid>
   <Grid Margin="0,1,0,7">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" x:Name="RecheckBeforeExecutionButton" Content="실행 직전 재점검 (생성 아님)"
            Click="RecheckBeforeExecution_Click" Padding="10,5" Margin="0,0,7,0"
            AutomationProperties.Name="사업별 계획 및 경로 읽기 전용 재점검"/>
    <Button Grid.Column="1" x:Name="CancelPreflightButton" Content="재점검 중지"
            Click="CancelPreflight_Click" IsEnabled="False" Padding="9,5" Margin="0,0,7,0"/>
    <Button Grid.Column="2" x:Name="CopyPreflightButton" Content="새 점검표 복사" IsEnabled="False"
            Click="CopyPreflight_Click" Padding="9,5" Margin="0,0,7,0"/>
    <Button Grid.Column="3" x:Name="CopyExecutionManifestButton" Content="실행 계획표 복사"
            Click="CopyExecutionManifest_Click" IsEnabled="False" Padding="9,5" Margin="0,0,7,0"
            AutomationProperties.Name="검증된 사업별 생성 계획표 복사 실제 폴더 생성 안 함"/>
    <TextBlock Grid.Column="4" x:Name="PreflightStatus" VerticalAlignment="Center" TextWrapping="Wrap"
               Text="읽기 전용 검토 확인 이후 재점검할 수 있습니다." FontSize="11"
               Foreground="{DynamicResource TextMuted}"/>
   </Grid>
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="검토표 복사 (저장 아님)" Click="CopyReadiness_Click" Padding="12,6" Margin="0,0,7,0"
             AutomationProperties.Name="읽기 전용 생성 준비 검토표 클립보드 복사"/>
     <Button Content="닫기" Click="CloseReview_Click" Padding="16,6" IsCancel="True"/>
    </StackPanel>
    <TextBlock Text="실제 생성 기능 잠금 유지 · 이 창은 운영 승인/서명/출시를 수행하지 않습니다."
               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>
