<Window x:Class="Sunrise.FileManager.Controls.FilePropertiesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Title="파일 속성 · Sunrise File Manager"
 Width="690" Height="640" MinWidth="590" MinHeight="510"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Background="{DynamicResource AppBackground}">
  <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource ThemeShellBrand}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="20,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource ThemeSplitActive}" Width="38" Height="38" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
     <TextBlock Text="i" Foreground="{DynamicResource ThemeSplitActiveText}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock x:Name="HeaderFileName" Text="파일 속성" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeShellBrandText}"/>
     <TextBlock x:Name="HeaderSubline" Text="Sunrise File Manager" Margin="0,6,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeShellBrandMuted}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="6" Margin="14,12,14,6">
   <TabControl Margin="10,8,10,8">
    <TabItem Header="일반">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,12,10,10">
      <StackPanel>
       <StackPanel x:Name="GeneralInfo"/>
       <Separator Margin="0,12,0,12"/>
       <TextBlock Text="파일 특성" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
       <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="ReadOnlyCheck" Content="읽기 전용" Margin="0,0,20,0" Click="AttributeCheck_Click"/>
        <CheckBox x:Name="HiddenCheck" Content="숨김" Click="AttributeCheck_Click"/>
       </StackPanel>
       <TextBlock x:Name="AttributesNote" Text="파일 1개를 선택한 경우에만 특성을 변경할 수 있습니다." Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,8,0,6" TextWrapping="Wrap"/>
       <Button x:Name="ApplyAttributesButton" Content="특성 변경 적용" Click="ApplyAttributes_Click" Style="{StaticResource ExplorerCommand}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,5,0,0"/>
       <TextBlock x:Name="GeneralStatus" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="상세 · 메타데이터">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,12,10,10">
      <StackPanel>
       <TextBlock Text="문서 · 파일 상세" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <StackPanel x:Name="DetailsInfo"/>
       <Separator Margin="0,12,0,12"/>
       <TextBlock Text="문서 메타데이터" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <StackPanel x:Name="MetadataInfo"/>
       <TextBlock x:Name="MetadataStatus" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,10"/>
       <WrapPanel>
        <Button x:Name="EditMetadataButton" Content="메타데이터 편집…" Style="{StaticResource ExplorerCommand}" Margin="0,0,8,0" Click="EditMetadata_Click"/>
        <Button x:Name="HashButton" Content="SHA-256 계산" Style="{StaticResource ExplorerCommand}" Click="Hash_Click"/>
       </WrapPanel>
       <TextBlock x:Name="HashResult" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,12,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="디지털 서명">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12,10,10">
      <StackPanel>
       <TextBlock Text="서명 인증서 정보" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <StackPanel x:Name="SignatureInfo"/>
       <TextBlock Text="인증서 표시 여부만으로 서명 무결성·신뢰성을 보증하지 않습니다. 최종 확인은 Windows 원본 속성을 사용하세요."
        Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,20,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="버전 정보">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12,10,10">
      <StackPanel>
       <TextBlock Text="Windows 실행 파일 버전 리소스" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <StackPanel x:Name="VersionInfo"/>
       <TextBlock Text="실행 파일 버전 정보가 없는 일반 문서는 비어 있을 수 있습니다."
        Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,20,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
  </Border>
  <Border Grid.Row="2" Background="{DynamicResource ThemeSoftAlt}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="14,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="WindowsFallbackButton" Grid.Column="0" Content="Windows 원본 속성 열기" ToolTip="Windows Shell 확장·보안·이전 버전 등 고급 속성을 확인합니다." Click="WindowsFallback_Click" Style="{StaticResource ExplorerCommand}" HorizontalAlignment="Left"/>
    <Button Grid.Column="1" Content="닫기" Width="88" Click="Close_Click" Style="{StaticResource PrimaryButton}" Background="{DynamicResource ThemeSplitActive}" Foreground="{DynamicResource ThemeSplitActiveText}"/>
   </Grid>
  </Border>
 </Grid>
</Window>
