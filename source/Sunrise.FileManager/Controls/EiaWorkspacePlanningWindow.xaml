<Window x:Class="Sunrise.FileManager.Controls.EiaWorkspacePlanningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="환경평가 용역 폴더 계획 · 사업별 검토"
        Width="1190" Height="865" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="2*" MinHeight="135"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="3*" MinHeight="120"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
   <Border DockPanel.Dock="Right" Padding="7,4" CornerRadius="4" Background="{DynamicResource ThemeSoftAlt}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
    <TextBlock Text="사업별 검토 · 운영 쓰기 잠금 · 자동 생성 비활성" FontWeight="SemiBold" FontSize="11"/>
   </Border>
   <StackPanel>
    <TextBlock Text="환경평가 용역 폴더 계획" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="사업과 평가유형에 따라 폴더 계획을 계산합니다. 회사·발주처 초안 비교는 선택 사항입니다. 기본안 경로 점검 후 누락 폴더를 생성할 수 있습니다."
               FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
   </StackPanel>
  </DockPanel>
  <!-- Bounded scrolling keeps the action bar, plan results and close command visible at small windows/DPI. -->
  <ScrollViewer Grid.Row="1" x:Name="WorkspaceInputsScroll" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"
                AutomationProperties.Name="사업 기본정보 및 상세 입력 스크롤">
   <StackPanel>
  <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Background="{DynamicResource ThemeSurface}" CornerRadius="6" Padding="11" Margin="0,0,0,8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="98"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <TextBlock Text="사업번호" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Visibility="Collapsed"/>
    <TextBox x:Name="ProjectCodeInput" Visibility="Collapsed" Text="INTERNAL" MaxLength="45" Grid.Row="0" Grid.Column="1" Margin="0,0,14,7" ToolTip="예: PRJ-2026-001" AutomationProperties.Name="사업번호"/>
    <TextBlock Text="사업명" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
    <TextBox x:Name="ProjectTitleInput" MaxLength="80" Grid.Row="0" Grid.Column="3" Margin="0,0,0,7" AutomationProperties.Name="사업명"/>
    <TextBlock Text="계약번호" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Visibility="Collapsed"/>
    <TextBox x:Name="ContractCodeInput" Visibility="Collapsed" Text="INTERNAL" MaxLength="45" Grid.Row="1" Grid.Column="1" Margin="0,0,14,7" AutomationProperties.Name="용역계약번호"/>
    <TextBlock Text="용역명" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
    <TextBox x:Name="ContractDescriptionInput" MaxLength="80" Grid.Row="1" Grid.Column="3" Margin="0,0,0,7" AutomationProperties.Name="용역명"/>
    <TextBlock Text="평가 유형" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"/>
    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Vertical">
     <ItemsControl x:Name="WorkstreamChoices" AutomationProperties.Name="평가 유형 선택">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,5,18,5"/></DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="BaseCasesText" Text="기본 평가업무를 선택하세요. 상세 모드에서는 체크 해제 후 별도 평가업무만 등록할 수도 있습니다."
                FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
      <TextBlock Text="구성 유형" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <ComboBox x:Name="CoreModeSelector" Width="165" SelectedIndex="0" AutomationProperties.Name="폴더 구성 유형">
       <ComboBoxItem Content="표준형 (standard)" Tag="standard"/>
       <ComboBoxItem Content="최소형 (minimal)" Tag="minimal"/>
      </ComboBox>
      <TextBlock Text="상세 입력을 펼치면 CASE-01부터 생성되는 기본 평가업무를 추가 사건과 연결할 수 있습니다."
                 VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
     </StackPanel>
    </StackPanel>
   </Grid>
  </Border>
  <!-- DEV2: optional read-only detailed case input. Every edit invalidates the prior preview. -->
  <Expander x:Name="DetailExpander" Header="복합계약 · 업무상황 48 · 선택적 회사·발주처 초안 비교"
            Expanded="DetailMode_Changed" Collapsed="DetailMode_Changed" Margin="0,0,0,8"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="8"
            Background="{DynamicResource ThemeSurface}" AutomationProperties.Name="용역 상세 입력">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="5,0,0,5"
               Text="위 계약은 기본 계약이며 선택한 유형은 화면에 안내된 CASE-01, CASE-02…로 연결됩니다. 기본 유형을 체크하지 않고 상세 평가업무만 등록해도 됩니다. 아래는 추가 계약·추가 평가업무 및 사건 기록입니다. 참조번호는 화면의 실제 평가업무번호를 입력하세요. 법정 대상과 조사기간은 자동 판정하지 않습니다."/>
    <TabControl Grid.Row="1" Height="335" x:Name="DetailTabs" KeyboardNavigation.TabNavigation="Continue">
     <TabItem Header="추가 계약">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DataGrid x:Name="ContractRowsGrid" AutoGenerateColumns="False" ItemsSource="{Binding ExtraContracts}"
          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" CellEditEnding="DetailCell_Changed" RowEditEnding="DetailRow_Changed" AutomationProperties.Name="추가 계약 목록">
        <DataGrid.Columns>
         <DataGridTextColumn Header="계약번호" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
         <DataGridTextColumn Header="용역명" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="4*"/>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
        <Button Content="계약 추가" Click="AddContract_Click" Padding="10,4" Margin="0,0,7,0"/>
        <Button Content="선택 계약 삭제" Click="RemoveContract_Click" Padding="10,4"/>
       </StackPanel>
      </Grid>
     </TabItem>
     <TabItem Header="추가 평가업무">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DataGrid x:Name="CaseRowsGrid" AutoGenerateColumns="False" ItemsSource="{Binding ExtraCases}"
          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" CellEditEnding="DetailCell_Changed" RowEditEnding="DetailRow_Changed" AutomationProperties.Name="추가 평가업무 목록">
        <DataGrid.Columns>
         <DataGridTextColumn Header="평가업무번호" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
         <DataGridTextColumn Header="소속 계약번호" Binding="{Binding ContractCode, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
         <DataGridComboBoxColumn x:Name="CaseWorkstreamColumn" Header="평가 유형" SelectedValueBinding="{Binding Workstream, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" SelectedValuePath="Id" Width="2*"/>
         <DataGridTextColumn Header="선행·원평가업무번호 (선택)" Binding="{Binding RelatedCaseCode, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
        <Button Content="평가업무 추가" Click="AddCase_Click" Padding="10,4" Margin="0,0,7,0"/>
        <Button Content="선택 업무 삭제" Click="RemoveCase_Click" Padding="10,4"/>
       </StackPanel>
      </Grid>
     </TabItem>
     <TabItem Header="설계자료 수령">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DataGrid x:Name="IntakeRowsGrid" AutoGenerateColumns="False" ItemsSource="{Binding DesignIntakes}"
          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" CellEditEnding="DetailCell_Changed" RowEditEnding="DetailRow_Changed" AutomationProperties.Name="설계자료 수령차수 목록">
        <DataGrid.Columns>
         <DataGridTextColumn Header="평가업무번호" Binding="{Binding CaseCode, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
         <DataGridTextColumn Header="자료 식별자" Binding="{Binding ReferenceCode, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
         <DataGridTextColumn Header="수령차수 (1~99)" Binding="{Binding Round, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0"><Button Content="수령 기록 추가" Click="AddIntake_Click" Padding="10,4" Margin="0,0,7,0"/><Button Content="선택 기록 삭제" Click="RemoveIntake_Click" Padding="10,4"/></StackPanel>
      </Grid>
     </TabItem>
     <TabItem Header="기관 보완">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DataGrid x:Name="CorrectionRowsGrid" AutoGenerateColumns="False" ItemsSource="{Binding Corrections}"
          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" CellEditEnding="DetailCell_Changed" RowEditEnding="DetailRow_Changed" AutomationProperties.Name="검토기관 보완차수 목록">
        <DataGrid.Columns>
         <DataGridTextColumn Header="평가업무번호" Binding="{Binding CaseCode, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
         <DataGridTextColumn Header="검토기관 식별자" Binding="{Binding AgencyCode, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
         <DataGridTextColumn Header="보완차수 (1~99)" Binding="{Binding Round, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0"><Button Content="보완 기록 추가" Click="AddCorrection_Click" Padding="10,4" Margin="0,0,7,0"/><Button Content="선택 기록 삭제" Click="RemoveCorrection_Click" Padding="10,4"/></StackPanel>
      </Grid>
     </TabItem>
     <TabItem Header="사후조사 연차">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DataGrid x:Name="FollowupRowsGrid" AutoGenerateColumns="False" ItemsSource="{Binding FollowupYears}"
          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" CellEditEnding="DetailCell_Changed" RowEditEnding="DetailRow_Changed" AutomationProperties.Name="사후조사 연도별 차수 목록">
        <DataGrid.Columns>
         <DataGridTextColumn Header="사후조사 평가업무번호" Binding="{Binding CaseCode, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
         <DataGridTextColumn Header="조사연도 (YYYY)" Binding="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
         <DataGridTextColumn Header="해당 연도 조사차수" Binding="{Binding Round, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0"><Button Content="연차 기록 추가" Click="AddFollowup_Click" Padding="10,4" Margin="0,0,7,0"/><Button Content="선택 연차 삭제" Click="RemoveFollowup_Click" Padding="10,4"/></StackPanel>
      </Grid>
     </TabItem>
     <TabItem x:Name="ScenarioTab" Header="업무상황 48">
      <Grid Margin="4">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="ScenarioFilterInput" Grid.Row="0" TextChanged="ScenarioFilter_Changed"
          ToolTip="S01~S48 ID, 상황명, 위험방지 기준 검색" AutomationProperties.Name="업무상황 카탈로그 검색" Margin="0,0,0,4"/>
        <TextBlock x:Name="ScenarioCatalogInfo" Grid.Row="1" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,3"
                   Foreground="{DynamicResource TextMuted}" Text="상황을 선택하면 적용 유형·검토 필요 여부를 표시합니다."/>
        <ListBox x:Name="ScenarioCatalogList" Grid.Row="2" AutomationProperties.Name="48개 업무상황 카탈로그"
                 SelectionChanged="ScenarioCatalog_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <StackPanel Margin="1,2" ToolTip="{Binding RiskGuard}">
            <TextBlock FontSize="12" FontWeight="SemiBold">
             <Run Text="{Binding Id}"/><Run Text="  "/><Run Text="{Binding Title}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal">
             <TextBlock Text="{Binding Scope}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
             <TextBlock Text=" · " FontSize="10"/>
             <TextBlock Text="{Binding Mode}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
           </StackPanel>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="3" Content="선택한 상황 추가" Click="AddScenario_Click" Padding="10,4" Margin="0,5,0,0"/>
       </Grid>
       <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="상황 ID·범위는 카탈로그 기준입니다. 참조번호, 평가업무/계약번호와 확인 상태를 명시하세요. 담당자 검토는 공식 승인 아님."
                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
        <DataGrid x:Name="ScenarioRowsGrid" Grid.Row="1" AutoGenerateColumns="False"
          ItemsSource="{Binding ScenarioRows}" CanUserAddRows="False" CanUserDeleteRows="False"
          SelectionMode="Single" CellEditEnding="DetailCell_Changed" RowEditEnding="DetailRow_Changed"
          AutomationProperties.Name="선택 업무상황 목록 (명시 확인 필수)"
          HorizontalScrollBarVisibility="Auto">
         <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding ScenarioId}" IsReadOnly="True" Width="52"/>
          <DataGridTextColumn Header="범위" Binding="{Binding ScopeLabel}" IsReadOnly="True" Width="68"/>
          <DataGridTextColumn Header="참조번호" Binding="{Binding ReferenceCode, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
          <DataGridTextColumn Header="평가업무번호" Binding="{Binding CaseCode, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
          <DataGridTextColumn Header="계약번호" Binding="{Binding ContractCode, UpdateSourceTrigger=PropertyChanged}" Width="98"/>
          <DataGridTextColumn Header="차수" Binding="{Binding Round, UpdateSourceTrigger=PropertyChanged}" Width="53"/>
          <DataGridCheckBoxColumn Header="선택확인" Binding="{Binding UserConfirmed, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
          <DataGridCheckBoxColumn Header="담당자검토" Binding="{Binding HumanLegalReviewConfirmed, UpdateSourceTrigger=PropertyChanged}" Width="84"/>
         </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,5,0,0" LastChildFill="True">
         <Button DockPanel.Dock="Right" Content="선택 상황 삭제" Click="RemoveScenario_Click" Padding="9,3"/>
         <TextBlock x:Name="ScenarioOutcomeText" Text="선택한 상황의 처리 결과는 '폴더 계획 계산' 이후 표시됩니다."
                    FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
       </Grid>
      </Grid>
     </TabItem>
     <TabItem Header="상황 처리 결과">
      <Grid Margin="4">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Text="선택된 상황별 처리 결과입니다. 기존 자료 참조·안전검증 항목에는 신규 폴더를 제안하지 않습니다. 모든 상황은 미승인 상태입니다."
                  FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,5"/>
       <DataGrid x:Name="ScenarioOutcomesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
           CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
           EnableRowVirtualization="True" AutomationProperties.Name="선택 업무상황 처리 결과 및 미검증 상태">
        <DataGrid.Columns>
         <DataGridTextColumn Header="ID" Binding="{Binding ScenarioId}" Width="52"/>
         <DataGridTextColumn Header="참조번호" Binding="{Binding ReferenceCode}" Width="115"/>
         <DataGridTextColumn Header="처리 상태" Binding="{Binding StatusLabel}" Width="215"/>
         <DataGridTextColumn Header="평가업무" Binding="{Binding CaseCode}" Width="90"/>
         <DataGridTextColumn Header="계약" Binding="{Binding ContractCode}" Width="90"/>
         <DataGridTextColumn Header="검토·안전 주의사항" Binding="{Binding Explanation}" Width="2*" MinWidth="175"/>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </TabItem>
     <TabItem x:Name="ProfileTab" Header="회사·발주처 표준 초안">
      <TabItem.Resources>
       <Style x:Key="ProfileReadOnlyCellText" TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </Style>
      </TabItem.Resources>
      <Grid Margin="4">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <WrapPanel Grid.Row="0" Margin="0,0,0,4">
        <TextBlock Text="회사 식별자" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="ProfileCompanyInput" MaxLength="48" Width="110" Margin="0,0,10,0" AutomationProperties.Name="프로파일 회사 식별자"/>
        <TextBlock Text="과업지시서 식별자" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="ProfileRequirementInput" MaxLength="48" Width="115" Margin="0,0,10,0" AutomationProperties.Name="프로파일 과업지시서 식별자"/>
        <TextBlock Text="프로파일 ID" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="ProfileIdInput" MaxLength="48" Width="120" AutomationProperties.Name="프로파일 ID"/>
       </WrapPanel>
       <WrapPanel Grid.Row="1" Margin="0,0,0,4">
        <Button Content="저장된 최신 초안 조회" Click="LoadProfile_Click" Padding="9,3" Margin="0,0,7,0"/>
        <Button x:Name="CompareProfileButton" Content="직전 개정과 비교" Click="CompareProfile_Click" Padding="9,3" IsEnabled="False" Margin="0,0,7,0"/>
        <Button x:Name="CompareAppliedProfileButton" Content="현재 사업에 적용 비교" Click="CompareAppliedProfile_Click" Padding="9,3" IsEnabled="False" Margin="0,0,7,0" AutomationProperties.Name="회사 표준을 현재 사업 미리보기에 읽기 전용 비교"/>
        <TextBlock Text="로컬 저장된 UNAPPROVED 초안만 읽기 · 새 저장소 생성 없음" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
       </WrapPanel>
       <TabControl Grid.Row="2">
        <TabItem Header="회사·발주처 폴더 제안">
         <DataGrid x:Name="ProfileEntriesGrid" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinColumnWidth="65" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" EnableRowVirtualization="True" AutomationProperties.Name="미승인 회사 및 발주처 폴더 제안">
          <DataGrid.Columns>
           <DataGridTextColumn Header="항목 ID" Binding="{Binding Key}" Width="100"/>
           <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="75"/>
           <DataGridTextColumn Header="상대경로" Binding="{Binding RelativePath}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="3*"/>
           <DataGridTextColumn Header="필수 초안" Binding="{Binding MandatoryLabel}" Width="120"/>
           <DataGridTextColumn Header="검토 상태" Binding="{Binding ReviewStatus}" Width="2*"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
        <TabItem Header="회사·발주처 경로 충돌">
         <DataGrid x:Name="ProfileConflictsGrid" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinColumnWidth="65" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" AutomationProperties.Name="발주처 충돌과 명시적 결정">
          <DataGrid.Columns>
           <DataGridTextColumn Header="항목 ID" Binding="{Binding Key}" Width="90"/>
           <DataGridTextColumn Header="회사 제안 경로" Binding="{Binding CompanyPath}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="2*"/>
           <DataGridTextColumn Header="발주처 제안 경로" Binding="{Binding ClientPath}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="2*"/>
           <DataGridTextColumn Header="선택 출처" Binding="{Binding SelectedSource}" Width="85"/>
           <DataGridTextColumn Header="검토 근거" Binding="{Binding Rationale}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="2*"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
        <TabItem Header="직전 개정 대비 변경">
         <DataGrid x:Name="ProfileChangesGrid" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinColumnWidth="65" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" AutomationProperties.Name="초안 개정 비교 실제 폴더 조작 없음">
          <DataGrid.Columns>
           <DataGridTextColumn Header="차이 구분" Binding="{Binding ChangeType}" Width="145"/>
           <DataGridTextColumn Header="항목 ID" Binding="{Binding Key}" Width="90"/>
           <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="100"/>
           <DataGridTextColumn Header="이전 초안" Binding="{Binding PreviousValue}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="2*"/>
           <DataGridTextColumn Header="현재 초안" Binding="{Binding CurrentValue}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="2*"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
        <TabItem Header="현재 사업 적용 차이 (읽기 전용)">
         <Grid Margin="3">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,4">
           <TextBlock x:Name="ProfileAppliedSummary" FontSize="11" Foreground="{DynamicResource TextMuted}"
                      Text="사업의 폴더 계획과 저장된 미승인 초안을 각각 조회한 후 ‘현재 사업에 적용 비교’를 누르세요." TextWrapping="Wrap"/>
           <WrapPanel Margin="0,3,0,0">
            <Button x:Name="InspectProfileDestinationButton" Content="프로파일 포함 위치 점검" Padding="9,3"
                    IsEnabled="False" Click="InspectProfileDestination_Click" Margin="0,0,7,0"
                    ToolTip="선택한 기존 저장 위치에서 기본안과 회사·발주처 추가 경로를 읽기 전용 점검합니다. 파일·폴더를 생성하지 않습니다."
                    AutomationProperties.Name="미승인 회사 발주처 프로파일 포함 실제 위치 안전 점검"/>
            <Button x:Name="CancelProfileDestinationButton" Content="점검 중지" Padding="8,3"
                    Click="CancelProfileDestination_Click" IsEnabled="False" Margin="0,0,7,0"
                    ToolTip="파일시스템 조회의 취소를 요청합니다. 이미 시작된 네트워크 I/O는 반환 후 중단될 수 있습니다."
                    AutomationProperties.Name="회사 프로파일 포함 저장 위치 점검 중지"/>
            <TextBlock x:Name="ProfileDestinationStatus" Text="회사 적용 비교 후 프로파일 포함 위치 점검이 가능합니다."
                       FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
           </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="ProfileAppliedPathsGrid" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinColumnWidth="65" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" AutomationProperties.Name="현재 사업 기본안과 회사 발주처 초안 경로 비교">
           <DataGrid.Columns>
            <DataGridTextColumn Header="경로 구분" Binding="{Binding ChangeLabel}" Width="170"/>
            <DataGridTextColumn Header="상대경로" Binding="{Binding RelativePath}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="3*"/>
            <DataGridTextColumn Header="근거 출처" Binding="{Binding Origin}" Width="120"/>
            <DataGridTextColumn Header="항목 ID" Binding="{Binding RuleKeys}" Width="110"/>
            <DataGridTextColumn Header="제안 근거" Binding="{Binding Rationale}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="2*"/>
           </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="초안 비교는 선택 사항 · 사업별 계획 검토와 구분" FontSize="11" Margin="0,5,0,3" Foreground="{DynamicResource TextMuted}"/>
          <DataGrid x:Name="ProfileAppliedDecisionsGrid" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinColumnWidth="65" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" AutomationProperties.Name="회사 발주처 충돌 선택 및 적용 근거">
           <DataGrid.Columns>
            <DataGridTextColumn Header="항목 ID" Binding="{Binding Key}" Width="85"/>
            <DataGridTextColumn Header="선택 출처" Binding="{Binding Source}" Width="90"/>
            <DataGridTextColumn Header="제안 경로" Binding="{Binding RelativePath}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="3*"/>
            <DataGridTextColumn Header="판정" Binding="{Binding Decision}" Width="150"/>
            <DataGridTextColumn Header="명시적 근거" Binding="{Binding Rationale}" ElementStyle="{StaticResource ProfileReadOnlyCellText}" Width="2*"/>
           </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="4" Margin="0,7,0,0">
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Row="0" Text="적용 지문 · SHA-256 (읽기 전용)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
           <TextBox x:Name="ProfileAppliedFingerprintText" Grid.Row="1" Grid.ColumnSpan="2"
                    IsReadOnly="True" IsReadOnlyCaretVisible="True" MinHeight="25" Margin="0,2,0,4"
                    HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="읽기 전용 적용 계획 전체 지문"
                    ToolTip="지문은 미승인 경로 비교의 식별값이며 회사나 법정 승인을 뜻하지 않습니다."/>
           <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
             <TextBlock Text="개인 검토 메모 · 현재 비교 화면에서만 유지 (저장·승인 아님)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
             <TextBox x:Name="ProfileReviewNotesInput" Height="38" AcceptsReturn="True" TextWrapping="Wrap"
                      VerticalScrollBarVisibility="Auto" MaxLength="1000" IsEnabled="False"
                      AutomationProperties.Name="개인 검토 메모 저장되지 않음" ToolTip="미승인 계획의 사용자 메모입니다. 적용 지문에 포함되지 않으며 자동 저장되지 않습니다."/>
            </StackPanel>
            <Button x:Name="CopyProfileReviewButton" Grid.Column="1" VerticalAlignment="Bottom" Margin="7,0,0,0"
                    Content="검토 메모 복사" Click="CopyProfileReview_Click" IsEnabled="False"
                    Padding="9,5" AutomationProperties.Name="검토 메모를 명시적으로 클립보드 복사"/>
           </Grid>
          </Grid>
         </Grid>
        </TabItem>
       </TabControl>
       <TextBlock x:Name="ProfileStatusText" Grid.Row="3" FontSize="11" Foreground="{DynamicResource TextMuted}" Text="미승인 초안을 조회하세요. 현재 사업의 실제 폴더·저장소를 변경하지 않습니다." TextWrapping="Wrap" Margin="0,5,0,0"/>
      </Grid>
     </TabItem>
    </TabControl>
   </Grid>
  </Expander>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="7,8,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock x:Name="SummaryText" Text="사업정보를 입력한 뒤 ‘폴더 계획 계산’을 누르세요." FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="StatusText" Text="운영용 생성 엔진 및 Windows·경로·권한·NAS 실기검증 전에는 폴더 생성 기능을 사용할 수 없습니다." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
    <Button x:Name="PreviewButton" Content="폴더 계획 계산" Click="Preview_Click" Padding="13,7" Margin="0,0,8,0" IsDefault="True"/>
    <Button x:Name="CopyButton" Content="계획 텍스트 복사" Click="Copy_Click" IsEnabled="False" Padding="11,7"/>
   </StackPanel>
  </Grid>
  <!-- DEV11 destination preflight is observation only, never a create/apply button. -->
  <!-- DEV15: action row and live status are separate so 860px/DPI layouts
       do not squeeze the path editor between status and stop buttons. -->
  <Grid Grid.Row="3" Margin="7,0,0,7">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Grid.Row="0" Grid.Column="0" Text="저장 위치 안전 점검" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"/>
   <TextBox Grid.Row="0" Grid.Column="1" x:Name="DestinationPathInput" MaxLength="500" VerticalContentAlignment="Center"
            MinWidth="100" ToolTip="이미 존재하는 기준 폴더의 절대경로를 붙여 넣으세요. 폴더를 생성하지 않습니다."
            AutomationProperties.Name="읽기 전용 기존 기준 폴더 절대경로"/>
   <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="7,0,0,0">
    <Button Content="폴더 선택" Click="ChooseDestination_Click" Padding="8,4" Margin="0,0,5,0"
            ToolTip="이미 존재하는 기준 폴더 선택. 생성하지 않습니다."/>
    <Button x:Name="InspectDestinationButton" Content="위치 점검" Padding="9,4"
            IsEnabled="False" Click="InspectDestination_Click"
            ToolTip="현재 폴더 계획과 기존 경로를 읽기 전용으로 대조합니다. 생성 및 쓰기는 하지 않습니다."/>
    <Button x:Name="ExecutionReadinessButton" Content="생성 준비 검토" Padding="9,4" Margin="6,0,0,0"
            IsEnabled="False" Click="ExecutionReadiness_Click"
            ToolTip="사업별 계획 및 경로별 상태·생성 예상 개수를 읽기 전용으로 검토합니다. 이 버튼 자체는 생성하지 않으며 검토창에서 따로 승인합니다."
            AutomationProperties.Name="사업별 폴더 생성 전 검토창 열기"/>
    <Button x:Name="CancelDestinationButton" Content="중지" Padding="7,4" Margin="5,0,0,0"
            Click="CancelDestination_Click" IsEnabled="False"
            ToolTip="읽기 전용 위치 점검 취소 요청. 진행 중인 네트워크 조회는 즉시 종료되지 않을 수 있습니다."
            AutomationProperties.Name="기본안 저장 위치 점검 중지"/>
   </StackPanel>
   <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DestinationInspectionStatus"
              Text="계획 계산 후 저장 예정 위치를 점검할 수 있습니다."
              TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
              VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
              AutomationProperties.LiveSetting="Polite"/>
  </Grid>
  <Border Grid.Row="4" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ThemeSurface}" Padding="3">
   <Border.Resources>
    <Style x:Key="DestinationDiagnosticCellText" TargetType="{x:Type TextBlock}">
     <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
     <Setter Property="VerticalAlignment" Value="Center"/>
     <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
   </Border.Resources>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="6,5,6,6" LastChildFill="True">
     <TextBlock DockPanel.Dock="Left" Text="계획된 상대 폴더와 생성 근거" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
     <TextBox x:Name="FilterInput" TextChanged="Filter_Changed" AutomationProperties.Name="폴더 경로 및 생성 근거 필터" ToolTip="미리보기 결과만 필터합니다. 실제 생성 대상 목록은 변경하지 않습니다."/>
    </DockPanel>
    <TabControl Grid.Row="1" x:Name="DestinationReviewTabs" KeyboardNavigation.TabNavigation="Continue">
     <TabItem Header="계획 폴더">
      <DataGrid x:Name="FolderGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              CanUserDeleteRows="False" SelectionMode="Extended" GridLinesVisibility="Horizontal"
              EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column"
              AutomationProperties.Name="미리보기 폴더 목록">
     <DataGrid.Columns>
      <DataGridTextColumn Header="상대경로" Binding="{Binding RelativePath}" Width="3*" MinWidth="220"/>
      <DataGridTextColumn Header="구분" Binding="{Binding CategoryLabel}" Width="125"/>
      <DataGridTextColumn Header="소유 범위" Binding="{Binding OwnerLabel}" Width="135"/>
      <DataGridTextColumn Header="생성 근거" Binding="{Binding Basis}" Width="2*" MinWidth="140"/>
     </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="저장 위치 진단 · 기본/회사">
      <Grid Margin="4">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" x:Name="DestinationReviewSummary" Text="위치 점검 실행 후 경로별 기존/필요/충돌 상태가 표시됩니다. 승인·폴더 생성 아님."
                  Margin="0,0,0,5" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <!-- View-only filter; original scan counts and BLOCKED state are immutable. -->
       <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Text="진단 상태" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="11"/>
        <ComboBox x:Name="DiagnosticStatusFilter" DockPanel.Dock="Left" Width="125" SelectedIndex="0"
                  Margin="0,0,10,0" AutomationProperties.Name="경로 진단 상태 필터">
         <ComboBoxItem Tag="ALL" Content="전체"/>
         <ComboBoxItem Tag="BLOCKED" Content="충돌·접근 불가"/>
         <ComboBoxItem Tag="MISSING" Content="새 폴더 필요"/>
         <ComboBoxItem Tag="EXISTS_DIRECTORY" Content="기존 폴더"/>
        </ComboBox>
        <TextBox x:Name="DiagnosticSearchInput" MinWidth="100" MaxLength="160"
                 ToolTip="경로·범위·원인·상태 검색. 이미 수집한 결과만 필터하며 파일시스템을 다시 조회하지 않습니다."
                 AutomationProperties.Name="경로 진단 결과 검색"/>
       </DockPanel>
       <DataGrid Grid.Row="2" x:Name="DestinationDiagnosticGrid" IsReadOnly="True" AutoGenerateColumns="False"
                 CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinColumnWidth="70"
                 AutomationProperties.Name="기본안 및 회사 발주처 저장 위치 경로별 읽기 전용 진단">
        <DataGrid.Columns>
         <DataGridTextColumn Header="범위" Binding="{Binding ScopeLabel}" Width="90"/>
         <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="125"/>
         <DataGridTextColumn Header="상대경로" Binding="{Binding RelativePath}" ElementStyle="{StaticResource DestinationDiagnosticCellText}" Width="3*"/>
         <DataGridTextColumn Header="실제 경로" Binding="{Binding AbsolutePath}" ElementStyle="{StaticResource DestinationDiagnosticCellText}" Width="3*"/>
         <DataGridTextColumn Header="원인/조치" Binding="{Binding Detail}" ElementStyle="{StaticResource DestinationDiagnosticCellText}" Width="2*"/>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </TabItem>
    </TabControl>
   </Grid>
  </Border>
  <DockPanel Grid.Row="5" Margin="0,9,0,0" LastChildFill="True">
   <Button Content="닫기" DockPanel.Dock="Right" Click="Close_Click" IsCancel="True" Padding="18,7"/>
   <TextBlock Text="사업별 검토 기능 · 실제 폴더 생성/저장/삭제/복구 버튼 없음 · 위치 점검은 읽기 전용이며 권한·NAS 실기 검증 전"
              Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
  </DockPanel>
 </Grid>
</Window>
