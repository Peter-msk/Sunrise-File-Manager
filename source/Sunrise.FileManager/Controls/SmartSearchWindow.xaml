<Window x:Class="Sunrise.FileManager.Controls.SmartSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Sunrise 스마트 검색 · 파일 및 폴더" Width="1030" Height="715"
        MinWidth="800" MinHeight="515" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
 <Window.Resources>
  <Style x:Key="SmartSearchLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,0,5,3"/>
  </Style>
  <!-- One visual contract: column headers and values align to center and never overlap. -->
  <Style x:Key="SearchColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PopupCenteredColumnHeader}">
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Padding" Value="8,7"/>
  </Style>
  <Style x:Key="SearchResultText" TargetType="TextBlock" BasedOn="{StaticResource PopupCenteredCellText}">
   <Setter Property="TextAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <Style x:Key="SmartSearchInput" TargetType="ComboBox">
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
 </Window.Resources>
 <Grid KeyboardNavigation.TabNavigation="Cycle">
  <Grid.RowDefinitions>
   <RowDefinition Height="62"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource ThemeShellBrand}" Padding="15,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Sunrise 스마트 검색" Foreground="{DynamicResource ThemeShellBrandText}" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="① 왼쪽에서 검색 위치 선택 → ② 위에서 검색어·유형 설정 → ③ 검색 시작" Foreground="{DynamicResource ThemeShellBrandMuted}" FontSize="11" Margin="0,3,0,0"/>
     </StackPanel>
    </StackPanel>
    <TextBlock Grid.Column="1" Text="읽기 전용 검색" Foreground="{DynamicResource ThemeShellBrandMuted}" VerticalAlignment="Center" FontSize="11"/>
   </Grid>
  </Border>
  <Border Grid.Row="1" Margin="10,9,10,8" Padding="8,8" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7">
   <!-- Fixed filter widths remain usable at small monitor sizes via a horizontal viewport. -->
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
   <StackPanel MinWidth="710">
    <Grid Margin="0,0,0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="163"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="0,0,8,0">
      <TextBlock Text="검색어 (파일명·폴더명)" Style="{StaticResource SmartSearchLabel}"/>
      <Grid>
       <TextBox AutomationProperties.Name="검색어" x:Name="QueryBox" Height="30" MaxLength="1000" Padding="7,4" KeyDown="QueryBox_KeyDown" TextChanged="QueryBox_TextChanged" ToolTip="파일명·폴더명 또는 기존 고급 검색식을 입력합니다."/>
       <TextBlock x:Name="QueryHint" Text="찾을 파일명 또는 폴더명을 입력하세요" Foreground="{DynamicResource TextMuted}" Opacity="0.75" Margin="9,6,0,0" IsHitTestVisible="False" VerticalAlignment="Top"/>
      </Grid>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <TextBlock Text="검색 대상" Style="{StaticResource SmartSearchLabel}"/>
      <ComboBox AutomationProperties.Name="파일 또는 폴더 검색 대상" x:Name="TargetCombo" Style="{StaticResource SmartSearchInput}" SelectionChanged="TargetCombo_SelectionChanged">
       <ComboBoxItem Content="전체" Tag="All"/><ComboBoxItem Content="파일만" Tag="Files"/><ComboBoxItem Content="폴더만" Tag="Folders"/>
      </ComboBox>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="파일 유형" Style="{StaticResource SmartSearchLabel}"/>
      <ComboBox AutomationProperties.Name="파일 유형 필터" x:Name="TypeCombo" Style="{StaticResource SmartSearchInput}" SelectionChanged="TypeCombo_SelectionChanged"/>
     </StackPanel>
     <StackPanel Grid.Column="3">
      <TextBlock Text="직접 입력 확장자" Style="{StaticResource SmartSearchLabel}"/>
      <TextBox AutomationProperties.Name="직접 입력 확장자" x:Name="CustomExtensionsBox" Height="30" Padding="7,4" IsEnabled="False" ToolTip="직접 입력 선택 후 .hwp, .pdf, .dwg 형식으로 작성"/>
     </StackPanel>
    </Grid>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="검색 범위" Style="{StaticResource SmartSearchLabel}"/>
      <ComboBox AutomationProperties.Name="검색 범위" x:Name="ScopeCombo" Height="29">
       <ComboBoxItem Content="선택한 폴더 바로 아래" Tag="Current"/>
       <ComboBoxItem Content="하위 폴더 포함 · 이름" Tag="Descendants"/>
       <ComboBoxItem Content="하위 폴더 포함 · 본문" Tag="Contents"/>
       <ComboBoxItem Content="Windows 인덱스" Tag="Index"/>
      </ComboBox>
     </StackPanel>
     <CheckBox Grid.Column="1" x:Name="ShowHiddenBox" Content="숨김 항목 포함" VerticalAlignment="Bottom" Margin="13,0,0,6"/>
     <TextBlock Grid.Column="2" Text="폴더만 선택 시 파일은 검사하지 않습니다." Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" FontSize="11" Margin="11,0,0,7" TextWrapping="Wrap"/>
     <Button Grid.Column="3" x:Name="CancelSearchButton" Content="중단" Width="67" Height="30" Margin="0,0,7,0" VerticalAlignment="Bottom" IsEnabled="False" Click="CancelSearch_Click"/>
     <Button Grid.Column="4" x:Name="StartSearchButton" Content="검색 시작" Width="91" Height="30" VerticalAlignment="Bottom" Click="StartSearch_Click"/>
    </Grid>
   </StackPanel>
   </ScrollViewer>
  </Border>
  <Grid Grid.Row="2" Margin="10,0,10,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource ThemeSoftAlt}" Padding="10,0" CornerRadius="7,7,0,0">
      <TextBlock Text="① 검색 위치 선택" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
     </Border>
     <Grid Grid.Row="1" Margin="8,7,8,6">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox AutomationProperties.Name="검색할 폴더 경로" x:Name="FolderPathBox" Grid.Row="0" Height="30" Padding="6,4" ToolTip="Google Drive 및 OneDrive 동기화 위치도 직접 입력할 수 있습니다" KeyDown="FolderPathBox_KeyDown"/>
      <Button x:Name="BrowseFolderButton" Grid.Row="1" Content="검색 폴더 선택…" HorizontalAlignment="Stretch" Margin="0,6,0,0" Height="28" Click="BrowseFolder_Click"/>
     </Grid>
     <TreeView AutomationProperties.Name="폴더 위치 탐색 트리" Grid.Row="2" x:Name="FolderTree" Margin="5,0,5,7" BorderThickness="0" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource TextPrimary}"
               SelectedItemChanged="FolderTree_SelectedItemChanged" TreeViewItem.Expanded="FolderTree_Expanded">
       <TreeView.ItemContainerStyle>
        <Style TargetType="TreeViewItem">
         <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
         <Setter Property="Padding" Value="3,4"/>
         <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        </Style>
       </TreeView.ItemContainerStyle>
      </TreeView>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="7" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource ThemeSplitter}"/>
   <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource ThemeSoftAlt}" CornerRadius="7,7,0,0" Padding="11,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="③ 검색 결과 · 더블클릭하여 원래 위치 열기" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
       <TextBlock x:Name="ResultCount" Grid.Column="1" Text="0개" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" FontSize="11"/>
      </Grid>
     </Border>
     <DataGrid Style="{StaticResource PopupResultDataGrid}" AutomationProperties.Name="파일 및 폴더 검색 결과" x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
               GridLinesVisibility="Horizontal" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="32" ColumnHeaderHeight="36"
               ColumnHeaderStyle="{StaticResource SearchColumnHeader}"
               MouseDoubleClick="ResultsGrid_MouseDoubleClick">
      <DataGrid.Columns>
       <DataGridTextColumn Header="이름" ElementStyle="{StaticResource SearchResultText}" Binding="{Binding Name}" Width="2*" MinWidth="135"/>
       <DataGridTextColumn Header="유형" ElementStyle="{StaticResource SearchResultText}" Binding="{Binding TypeName}" Width="105"/>
       <DataGridTextColumn Header="크기 (B)" ElementStyle="{StaticResource SearchResultText}" Binding="{Binding SizeBytes, StringFormat=N0}" Width="92"/>
       <DataGridTextColumn Header="수정 날짜" ElementStyle="{StaticResource SearchResultText}" Binding="{Binding ModifiedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="135"/>
       <DataGridTextColumn Header="위치" ElementStyle="{StaticResource SearchResultText}" Binding="{Binding ParentFolder}" Width="2*" MinWidth="145"/>
      </DataGrid.Columns>
     </DataGrid>
     <Grid Grid.Row="2" Margin="9,3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="결과 더블클릭 또는 버튼: 원래 탐색창에 위치 표시" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
      <Button x:Name="RevealButton" Grid.Column="1" Content="탐색창에서 위치 열기" Padding="12,4" IsEnabled="False" Click="RevealButton_Click"/>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="{DynamicResource ThemeStatus}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="14,0">
   <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Text="검색 위치를 선택하고 검색을 시작하세요. 클라우드 온라인 전용 문서는 본문 검색이 제한됩니다." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,7" FontSize="11" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Border>
 </Grid>
</Window>
