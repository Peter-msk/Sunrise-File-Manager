<Window x:Class="Sunrise.FileManager.Controls.OllamaSetupDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Title="온보드 AI (Ollama) 기능 안내 및 설치"
 Width="680" Height="620" MinWidth="580" MinHeight="520" WindowStartupLocation="CenterOwner">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="{DynamicResource Brand}" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="온보드 AI (Ollama) 로컬 연결 및 자동 설치 안내" Foreground="{DynamicResource ThemeSurface}" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Text="GitHub 오픈소스 (https://github.com/ollama/ollama) · 외부 클라우드 전송 없는 100% 내 PC 온보드 AI" Foreground="{DynamicResource Selected}" FontSize="12" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>

  <Border Grid.Row="1" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="이 기능은 어떤 기능인가요?" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
    <TextBlock x:Name="DescriptionBlock" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"/>
   </StackPanel>
  </Border>

  <Border Grid.Row="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,12">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0">
     <TextBlock Text="현재 PC 온보드 AI 상태" FontWeight="SemiBold" FontSize="12"/>
     <TextBlock x:Name="StatusText" Text="상태 확인 중..." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Button Grid.Row="0" Grid.Column="1" x:Name="RefreshStatusButton" Content="⟳ 상태 다시 확인" Click="RefreshStatus_Click" Style="{StaticResource ExplorerCommand}" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
     <TextBlock Text="사용할 온보드 AI 모델:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
     <ComboBox x:Name="ModelSelector" Width="210" SelectedIndex="0">
      <ComboBoxItem Content="qwen2.5:1.5b (한국어 우수 · 경량 권장)" Tag="qwen2.5:1.5b"/>
      <ComboBoxItem Content="llama3.2:1b (초경량 · 빠른 응답)" Tag="llama3.2:1b"/>
      <ComboBoxItem Content="gemma2:2b (균형형 로컬 모델)" Tag="gemma2:2b"/>
      <ComboBoxItem Content="qwen2.5:3b (고성능 문서 요약·분류)" Tag="qwen2.5:3b"/>
     </ComboBox>
     <TextBlock Text="설치 도구: Windows 기본 cmd.exe 전용" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <Border Grid.Row="3" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="10">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="CMD 설치 및 연결 진행 로그 (cmd.exe)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
    <TextBox Grid.Row="1" x:Name="InstallLogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Malgun Gothic" FontSize="11.5" Background="{DynamicResource ThemeSoft}" Padding="8"/>
    <ProgressBar Grid.Row="2" x:Name="InstallProgress" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
   </Grid>
  </Border>

  <Grid Grid.Row="4" Margin="0,14,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <Button Grid.Column="0" x:Name="OpenGitHubButton" Content="GitHub 열기" Click="OpenGitHub_Click" Style="{StaticResource ExplorerCommand}"/>
   <Button Grid.Column="2" x:Name="DeclineButton" Content="설치 안 함" ToolTip="Ollama를 설치하지 않고 로컬 규칙 엔진 사용" Click="Decline_Click" Style="{StaticResource ExplorerCommand}" Margin="0,0,8,0"/>
   <Button Grid.Column="3" x:Name="InstallButton" Content="Ollama 설치 · 연결" ToolTip="Ollama 설치 및 로컬 모델 연결" Click="Install_Click" Style="{StaticResource PrimaryButton}" FontWeight="SemiBold" Padding="14,6"/>
   <Button Grid.Column="4" x:Name="CloseSetupButton" Content="닫기" Click="CloseSetup_Click" Style="{StaticResource ExplorerCommand}" Margin="8,0,0,0"/>
  </Grid>
 </Grid>
</Window>
