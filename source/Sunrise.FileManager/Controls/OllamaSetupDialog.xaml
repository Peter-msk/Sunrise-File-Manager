<Window x:Class="Sunrise.FileManager.Controls.OllamaSetupDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Title="온보드 AI 안내 및 설치" Width="760" Height="760" MinWidth="580" MinHeight="520" WindowStartupLocation="CenterOwner">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Brand}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"><StackPanel>
   <TextBlock Text="내 PC에 맞는 온보드 AI" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="PC 사양을 확인하고 추천 모델을 선택하세요. 설치 여부는 직접 결정할 수 있습니다." Foreground="#D7EBFF" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="사용할 온보드 AI 모델" FontWeight="SemiBold" Margin="0,4,0,5"/>
   <ComboBox x:Name="ModelSelector" HorizontalAlignment="Stretch" MinHeight="36" SelectionChanged="ModelSelector_SelectionChanged" ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"/>
   <TextBlock x:Name="RecommendationText" Text="PC 사양에 맞는 모델을 확인하는 중..." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,10"/>
   <Expander Header="PC 사양 및 추천 기준" IsExpanded="True" Margin="0,0,0,8"><TextBlock x:Name="HardwareText" Text="CPU, RAM, GPU와 저장장치를 조회하는 중..." TextWrapping="Wrap" FontSize="12" Margin="8"/></Expander>
   <Expander Header="온보드 AI 기능 · 설치 안내" Margin="0,0,0,8"><TextBlock x:Name="DescriptionBlock" TextWrapping="Wrap" FontSize="12" Margin="8"/></Expander>
   <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,8"><StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" x:Name="RefreshStatusButton" Content="상태 다시 확인" Click="RefreshStatus_Click" Style="{StaticResource ExplorerCommand}"/><TextBlock Text="현재 AI 상태" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="StatusText" Text="상태 확인 중..." TextWrapping="Wrap" Margin="0,5,0,0"/>
   </StackPanel></Border>
   <TextBlock Text="설치 및 연결 기록" FontWeight="SemiBold" Margin="0,4,0,5"/>
   <TextBox x:Name="InstallLogBox" Height="120" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Malgun Gothic" FontSize="11.5"/>
   <ProgressBar x:Name="InstallProgress" Height="6" Margin="0,8,0,0" Visibility="Collapsed"/>
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button x:Name="OpenGitHubButton" Content="GitHub 열기" Click="OpenGitHub_Click" Style="{StaticResource ExplorerCommand}" Margin="0,0,6,6"/>
   <Button x:Name="DeclineButton" Content="설치 안 함" Click="Decline_Click" Style="{StaticResource ExplorerCommand}" Margin="0,0,6,6"/>
   <Button x:Name="InstallButton" Content="선택 모델 설치 · 연결" Click="Install_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
   <Button x:Name="CloseSetupButton" Content="닫기" Click="CloseSetup_Click" Style="{StaticResource ExplorerCommand}" Margin="0,0,0,6"/>
  </WrapPanel>
 </Grid>
</Window>
