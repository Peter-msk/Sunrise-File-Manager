<Window Style="{StaticResource AppWindow}" x:Class="Sunrise.FileManager.Controls.AiInspectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="로컬 중복 검사 · 내용 분류" Width="1050" Height="760" MinWidth="800" MinHeight="560"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="로컬 중복 검사 · 문서 내용 분류" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock x:Name="SelectionLabel" TextWrapping="Wrap" Margin="0,6"/>
   <WrapPanel>
    <TextBlock Text="파일 수 상한" VerticalAlignment="Center"/><TextBox x:Name="MaxFilesBox" Width="85" Margin="8,0,14,0"/>
    <TextBlock Text="중복 해시·분류 파일크기 상한(MB)" VerticalAlignment="Center"/><TextBox x:Name="MaxMiBBox" Width="85" Margin="8,0,14,0"/>
    <TextBlock Text="온보드 AI 호출 상한" VerticalAlignment="Center"/><TextBox x:Name="MaxCallsBox" Width="55" Margin="8,0,14,0"/>
    <CheckBox x:Name="Recursive" Content="선택 폴더의 하위 폴더 포함" IsChecked="True" VerticalAlignment="Center"/>
   </WrapPanel>
  </StackPanel>
  <Expander Grid.Row="1" Header="내용 분류 규칙 · 내용은 외부 전송하지 않음" Margin="0,8">
   <StackPanel>
    <TextBlock Text="텍스트(TXT·MD·CSV 등)는 1MB 이하, PDF·DOCX·HWPX·일반 HWP 5·XLSX·PPTX는 128MiB 이하의 지원 본문을 전체 검색합니다. 암호·DRM·OCR 및 문서 내부 크기 제한은 별도 안내합니다. 폴더=키워드1,키워드2 규칙으로 분류합니다." TextWrapping="Wrap"/>
    <TextBox x:Name="RulesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" Text="수질=수질,하천&#10;대기=대기,미세먼지" TextChanged="Rules_Changed" Margin="0,6"/>
    <CheckBox x:Name="ContentConsent" Content="선택한 파일의 텍스트·PDF·DOCX·HWPX·일반 HWP 5·XLSX·PPTX 본문을 PC 안에서 읽는 데 동의합니다." Checked="Rules_Changed" Unchecked="Rules_Changed"/>
    <WrapPanel Margin="0,6">
     <Button x:Name="DestinationButton" Content="분류 대상 폴더" Click="Destination_Click" Margin="0,0,6,0"/>
     <ComboBox x:Name="ActionSelector" SelectedIndex="0" Width="100" SelectionChanged="Rules_Changed"><ComboBoxItem Content="복사"/><ComboBoxItem Content="이동"/></ComboBox>
     <Button x:Name="ClassifyButton" Content="내용 분류 계획" Click="Classify_Click" Margin="6,0"/>
    </WrapPanel>
    <TextBlock x:Name="DestinationLabel" Text="대상 폴더 미지정" TextWrapping="Wrap"/>
   </StackPanel>
  </Expander>
  <WrapPanel Grid.Row="2" Margin="0,0,0,8">
   <Button x:Name="ScanButton" Content="중복 검사 시작" Click="Scan_Click" Margin="0,0,6,4"/>
   <Button x:Name="ImportButton" Content="검증된 분류 계획 가져오기" Click="Import_Click" IsEnabled="False" Margin="0,0,6,4"/>
   <Button Content="취소" Click="Cancel_Click" Margin="0,0,6,4"/>
   <TextBlock Text="검사·계획 단계에는 파일 변경 없음" VerticalAlignment="Center" Margin="6,0"/>
  </WrapPanel>
  <DataGrid x:Name="Results" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"/>
  <StackPanel Grid.Row="4" Margin="0,8,0,0">
   <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="12"/>
   <TextBlock x:Name="Status" Text="검사할 항목을 확인하세요." TextWrapping="Wrap" Margin="0,5"/>
   <Expander Header="건너뜀·오류 상세"><TextBox x:Name="Errors" IsReadOnly="True" MaxHeight="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander>
  </StackPanel>
 </Grid>
</Window>
