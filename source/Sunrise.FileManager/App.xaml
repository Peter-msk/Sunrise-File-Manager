<Application x:Class="Sunrise.FileManager.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
 <SolidColorBrush x:Key="AppBackground" Color="#F3F5F8"/>
 <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="PanelBorder" Color="#D6DEE8"/>
 <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="TextPrimary" Color="#172B43"/>
 <SolidColorBrush x:Key="TextMuted" Color="#52657A"/>
 <SolidColorBrush x:Key="Accent" Color="#096B94"/>
 <SolidColorBrush x:Key="Selected" Color="#DCEEF8"/>
 <SolidColorBrush x:Key="Brand" Color="#163A55"/>
 <SolidColorBrush x:Key="ThemeHeader" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="ThemeSurface" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="ThemeSoft" Color="#F7F9FC"/>
 <SolidColorBrush x:Key="ThemeSoftAlt" Color="#F0F4F8"/>
 <SolidColorBrush x:Key="ThemeTab" Color="#EEF2F7"/>
 <SolidColorBrush x:Key="ThemeTabInactive" Color="#E5EBF2"/>
 <SolidColorBrush x:Key="ThemeHover" Color="#E7EFF6"/>
 <SolidColorBrush x:Key="ThemePressed" Color="#D7E7F2"/>
 <SolidColorBrush x:Key="ThemeStatus" Color="#F8FAFC"/>
 <SolidColorBrush x:Key="ThemeTrack" Color="#D2DFEA"/>
 <SolidColorBrush x:Key="ThemeSplitter" Color="#A4B8CB"/>
 <SolidColorBrush x:Key="ThemeSplitterHover" Color="#2679A5"/>
 <SolidColorBrush x:Key="ThemeGrip" Color="#3A769C"/>
 <SolidColorBrush x:Key="ThemeMenuBar" Color="#EBF3F9"/>
 <SolidColorBrush x:Key="ThemeMenuHover" Color="#CDE8F5"/>
 <SolidColorBrush x:Key="ThemeMenuText" Color="#163A55"/>
 <SolidColorBrush x:Key="ThemeMenuPopup" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="ThemeMenuSeparator" Color="#C8D6E5"/>
 <SolidColorBrush x:Key="ThemeInputBorder" Color="#A9B9CA"/>
 <SolidColorBrush x:Key="ThemeAltRow" Color="#F8FAFC"/>
 <SolidColorBrush x:Key="ThemeFolderIcon" Color="#E9B748"/>
 <SolidColorBrush x:Key="ThemeFolderStroke" Color="#C58D25"/>
 <SolidColorBrush x:Key="ThemeFileIcon" Color="#F6FAFD"/>
 <SolidColorBrush x:Key="ThemeFileIconBorder" Color="#A9B9CA"/>
 <SolidColorBrush x:Key="ThemePreviewCanvas" Color="#F1F3F6"/>
 <SolidColorBrush x:Key="ThemeTreeCanvas" Color="#F5F7FA"/>
 <SolidColorBrush x:Key="ThemeNotice" Color="#FFF4D8"/>
 <SolidColorBrush x:Key="ThemeNoticeText" Color="#654C13"/>
 <SolidColorBrush x:Key="ThemeTransferBar" Color="#EAF1F7"/>
 <SolidColorBrush x:Key="ThemeColumnDivider" Color="#9AACC2"/>
 <SolidColorBrush x:Key="ThemeButtonOnAccent" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DCEEF8"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#172B43"/>
 <Style x:Key="AppWindow" TargetType="Window">
  <Setter Property="Icon" Value="/Sunrise.FileManager;component/Assets/SunriseFileManager.ico"/><Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="Background" Value="{DynamicResource AppBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
 </Style>
 <Style TargetType="Window" BasedOn="{StaticResource AppWindow}"/>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemePressed}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ExplorerCommand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource ThemeSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
  <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="11,5"/><Setter Property="Margin" Value="2,0"/>
 </Style>
 <Style x:Key="ExplorerToggle" TargetType="Button" BasedOn="{StaticResource ExplorerCommand}">
  <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
 </Style>
 <Style x:Key="ExplorerNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
  <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,0"/>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource ThemeButtonOnAccent}"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,6"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="8,5"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="4"/></Style>
 <Style TargetType="ContextMenu">
  <Setter Property="Background" Value="{DynamicResource ThemeMenuPopup}"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
 </Style>
 <Style x:Key="SunrisePaneMenu" TargetType="Menu">
  <Setter Property="Background" Value="{DynamicResource ThemeMenuBar}"/>
  <Setter Property="Foreground" Value="{DynamicResource ThemeMenuText}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style x:Key="SunrisePaneMenuItem" TargetType="MenuItem">
  <Style.Resources>
  <Style TargetType="Separator">
   <Setter Property="Margin" Value="8,4"/>
   <Setter Property="Height" Value="1"/>
   <Setter Property="Background" Value="{DynamicResource ThemeMenuSeparator}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
    <Border Background="{TemplateBinding Background}" Height="1" Margin="0,2"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  </Style.Resources>
  <Setter Property="Foreground" Value="{DynamicResource ThemeMenuText}"/>
  <Setter Property="Background" Value="{DynamicResource ThemeMenuPopup}"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Padding" Value="12,6"/>
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid SnapsToDevicePixels="True">
     <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="1" CornerRadius="4" Margin="1" Padding="{TemplateBinding Padding}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition x:Name="IconColumn" Width="20"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
       <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
       <Path x:Name="MenuCheck" Grid.Column="0" Visibility="Collapsed" Data="M1,5 L5,9 L12,1"
             Stroke="{DynamicResource ThemeMenuText}" StrokeThickness="2" Width="13" Height="11"
             HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="3" x:Name="Gesture" Text="{TemplateBinding InputGestureText}"
                  Foreground="{DynamicResource TextMuted}" FontWeight="Normal" Margin="20,0,8,0" VerticalAlignment="Center"/>
       <Path x:Name="SubmenuArrow" Grid.Column="4" Data="M 0 0 L 4 4 L 0 8"
             Stroke="{DynamicResource ThemeMenuText}" StrokeThickness="1.4" Width="5" Height="9"
             HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" StaysOpen="False"
            IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
            PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" PopupAnimation="Fade">
      <Border Background="{DynamicResource ThemeMenuPopup}" BorderBrush="{DynamicResource ThemeMenuSeparator}"
              BorderThickness="1" CornerRadius="5" Padding="4" MinWidth="190">
       <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
       <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
       </ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="Role" Value="TopLevelHeader">
      <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource ThemeMenuBar}"/>
      <Setter TargetName="IconColumn" Property="Width" Value="0"/>
      <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
      <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
     </Trigger>
     <Trigger Property="Role" Value="TopLevelItem">
      <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource ThemeMenuBar}"/>
      <Setter TargetName="IconColumn" Property="Width" Value="0"/>
      <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
     </Trigger>
     <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True">
      <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource ThemeMenuHover}"/>
      <Setter TargetName="MenuSurface" Property="BorderBrush" Value="{DynamicResource ThemeMenuSeparator}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeMenuText}"/>
     </Trigger>
     <Trigger Property="IsSubmenuOpen" Value="True">
      <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource Selected}"/>
      <Setter TargetName="MenuSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeMenuText}"/>
     </Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="MenuCheck" Property="Visibility" Value="Visible"/>
      <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource Selected}"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="MenuItem" BasedOn="{StaticResource SunrisePaneMenuItem}"/>
 <Style x:Key="SunriseVerticalSplitter" TargetType="GridSplitter">
  <Setter Property="Width" Value="11"/>
  <Setter Property="Background" Value="{DynamicResource ThemeSplitter}"/>
  <Setter Property="Cursor" Value="SizeWE"/>
  <Setter Property="ToolTip" Value="드래그하여 좌우 창 너비 조절"/>
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="GridSplitter">
    <Border x:Name="Handle" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0">
     <Border Width="4" Height="46" CornerRadius="2" Background="{DynamicResource ThemeGrip}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource ThemeSplitterHover}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="SunriseHorizontalSplitter" TargetType="GridSplitter">
  <Setter Property="Height" Value="11"/>
  <Setter Property="Background" Value="{DynamicResource ThemeSplitter}"/>
  <Setter Property="Cursor" Value="SizeNS"/>
  <Setter Property="ToolTip" Value="드래그하여 상하 창 높이 조절"/>
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="GridSplitter">
    <Border x:Name="Handle" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1">
     <Border Height="4" Width="46" CornerRadius="2" Background="{DynamicResource ThemeGrip}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource ThemeSplitterHover}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="DataGrid">
  <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  <Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{DynamicResource ThemeSurface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeAltRow}"/>
  <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
  <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/>
  <Setter Property="IsReadOnly" Value="True"/><Setter Property="RowHeight" Value="34"/><Setter Property="ColumnHeaderHeight" Value="36"/>
  <Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
  <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
 </Style>
 <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="DataGridColumnHeader">
  <Setter Property="Background" Value="{DynamicResource ThemeSoft}"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  <!-- Right divider and native resize gripper stay visible at every DPI. -->
  <Setter Property="BorderBrush" Value="{DynamicResource ThemeColumnDivider}"/>
  <Setter Property="BorderThickness" Value="0,0,2,1"/>
  <Setter Property="SeparatorBrush" Value="{DynamicResource ThemeColumnDivider}"/>
  <Setter Property="SeparatorVisibility" Value="Visible"/>
  <Setter Property="Padding" Value="8,6"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="4,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 <DataTemplate x:Key="FileIconTemplate">
  <Grid Width="28" Height="28">
   <Path x:Name="Folder" Visibility="Collapsed" Fill="{DynamicResource ThemeFolderIcon}" Stroke="{DynamicResource ThemeFolderStroke}" StrokeThickness="0.7" Data="M2,6 L11,6 14,9 26,9 26,24 2,24 Z"/>
   <Border x:Name="Document" Width="23" Height="27" Background="{DynamicResource ThemeFileIcon}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" CornerRadius="2">
    <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
  </Grid>
  <DataTemplate.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter TargetName="Folder" Property="Visibility" Value="Visible"/><Setter TargetName="Document" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
 </DataTemplate>
</Application.Resources></Application>
