@echo off
setlocal EnableExtensions DisableDelayedExpansion
REM R19 R08 - DEVELOPMENT-ONLY unsigned WPF build. Not an installer/release.
REM Requires .NET 10 SDK only. Never probes SignTool, certificates or Inno Setup.
REM Never executes tests, previews or reads company document contents.
set "NO_PAUSE=0"
set "CHECK_ONLY=0"
:parse_args
if "%~1"=="" goto :args_done
if /I "%~1"=="--no-pause" (set "NO_PAUSE=1" & shift & goto :parse_args)
if /I "%~1"=="--check-only" (set "CHECK_ONLY=1" & shift & goto :parse_args)
echo [ERROR] Unknown argument: %~1
echo Usage: BUILD_DEV_EXE.cmd [--check-only] [--no-pause]
exit /b 2
:args_done
cd /d "%~dp0"
if errorlevel 1 goto :fail_cd
set "ROOT=%CD%"
set "PROJECT=%ROOT%\source\Sunrise.FileManager\Sunrise.FileManager.csproj"
set "LOG_DIR=%ROOT%\build-logs"
set "DIST=%ROOT%\dist"
set "STAGE=%DIST%\_SFM_DEV_UNSIGNED_staging"
set "FINAL=%DIST%\SunriseFileManager_DEV_UNSIGNED"
set "PREVIOUS=%DIST%\_SFM_DEV_UNSIGNED_previous"
set "RESULT=%LOG_DIR%\R19_DEV_BUILD_RESULT.txt"
set "FAILED_STAGE=PREFLIGHT"
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"
if not exist "%LOG_DIR%" goto :fail_log
> "%RESULT%" echo STATUS=RUNNING
>> "%RESULT%" echo MODE=DEVELOPMENT_UNSIGNED
>> "%RESULT%" echo STAGE=PREFLIGHT
if not exist "%PROJECT%" goto :fail_source
if not exist "%ROOT%\global.json" goto :fail_source
if not exist "%ROOT%\build-tools\FindDotNet10.cmd" goto :fail_source
if /I not "%PROCESSOR_ARCHITECTURE%"=="AMD64" if /I not "%PROCESSOR_ARCHITEW6432%"=="AMD64" goto :fail_arch
set "SUNRISE_DOTNET_RESOLVED="
set "SUNRISE_DOTNET_VERSION="
set "DOTNET_CLI_TELEMETRY_OPTOUT=1"
set "DOTNET_NOLOGO=1"
set "DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1"
call "%ROOT%\build-tools\FindDotNet10.cmd" > "%LOG_DIR%\R19_dev_sdk_discovery.log" 2>&1
if errorlevel 1 goto :fail_sdk
if not defined SUNRISE_DOTNET_RESOLVED goto :fail_sdk
set "DOTNET_EXE=%SUNRISE_DOTNET_RESOLVED%"
for %%I in ("%DOTNET_EXE%") do set "DOTNET_ROOT=%%~dpI"
set "PATH=%DOTNET_ROOT%;%PATH%"
echo [READY] Windows x64 / .NET SDK %SUNRISE_DOTNET_VERSION%.
echo [MODE] Development unsigned EXE. NOT an official Sunrise Group release.
echo [INFO] SignTool / certificate / Inno Setup are NOT needed in this mode.
if "%CHECK_ONLY%"=="1" goto :check_pass
set "FAILED_STAGE=WPF_PUBLISH"
>> "%RESULT%" echo STAGE=WPF_PUBLISH
if not exist "%DIST%" mkdir "%DIST%"
if not exist "%DIST%" goto :fail_publish
REM Only clean the dedicated staging folder; never touch signed Setup or user data.
if exist "%STAGE%" rmdir /s /q "%STAGE%"
if exist "%STAGE%" goto :fail_publish
mkdir "%STAGE%\app"
if errorlevel 1 goto :fail_publish
REM dotnet publish includes compilation; no redundant dotnet build or document tests.
"%DOTNET_EXE%" publish "%PROJECT%" --configuration Release --framework net10.0-windows10.0.19041.0 --runtime win-x64 --self-contained true -p:PublishSingleFile=false -p:PublishTrimmed=false -p:SunriseCompanyBuild=true --output "%STAGE%\app" > "%LOG_DIR%\R19_dev_wpf_publish.log" 2>&1
if errorlevel 1 goto :fail_publish
for %%F in (Sunrise.FileManager.exe Sunrise.FileManager.dll hostfxr.dll coreclr.dll PresentationFramework.dll) do if not exist "%STAGE%\app\%%F" goto :fail_publish
(
  echo DEVELOPMENT-ONLY / UNSIGNED / NOT FOR DISTRIBUTION
  echo Generated by BUILD_DEV_EXE.cmd. No signing certificate or SignTool was used.
  echo Run app\Sunrise.FileManager.exe on an approved Windows x64 development PC.
  echo This is NOT an Inno Setup installer and must not replace the signed Setup EXE.
  echo This build does not bypass Windows SmartScreen or security software.
) > "%STAGE%\DEVELOPMENT_ONLY_UNSIGNED.txt"
if not exist "%STAGE%\DEVELOPMENT_ONLY_UNSIGNED.txt" goto :fail_publish
set "FAILED_STAGE=COMMIT"
>> "%RESULT%" echo STAGE=COMMIT
REM Publish must fully succeed BEFORE a previous working dev build is replaced.
if exist "%PREVIOUS%" rmdir /s /q "%PREVIOUS%"
if exist "%PREVIOUS%" goto :fail_commit
if exist "%FINAL%" (
  move "%FINAL%" "%PREVIOUS%" >nul
  if errorlevel 1 goto :fail_commit
  if exist "%FINAL%" goto :fail_commit
)
move "%STAGE%" "%FINAL%" >nul
if errorlevel 1 goto :fail_restore
if not exist "%FINAL%\app\Sunrise.FileManager.exe" goto :fail_restore
if exist "%PREVIOUS%" rmdir /s /q "%PREVIOUS%"
> "%RESULT%" echo STATUS=SUCCESS
>> "%RESULT%" echo MODE=DEVELOPMENT_UNSIGNED
>> "%RESULT%" echo STAGE=COMPLETE
>> "%RESULT%" echo SDK=%SUNRISE_DOTNET_VERSION%
>> "%RESULT%" echo SIGNED=NO
>> "%RESULT%" echo OFFICIAL_RELEASE=NO
>> "%RESULT%" echo EXE="%FINAL%\app\Sunrise.FileManager.exe"
echo [SUCCESS] Unsigned development EXE: "%FINAL%\app\Sunrise.FileManager.exe"
echo [NOTE] No installer or digitally signed release has been produced.
goto :success
:check_pass
> "%RESULT%" echo STATUS=READY_FOR_DEV_BUILD
>> "%RESULT%" echo MODE=DEVELOPMENT_UNSIGNED
>> "%RESULT%" echo STAGE=CHECK_ONLY
>> "%RESULT%" echo SDK=%SUNRISE_DOTNET_VERSION%
>> "%RESULT%" echo SIGNTOOL=NOT_REQUIRED
>> "%RESULT%" echo INSTALLER=NOT_REQUIRED
>> "%RESULT%" echo CERTIFICATE=NOT_REQUIRED
echo [CHECK PASS] SDK and source found; no build or certificate operation performed.
goto :success
:fail_cd
echo [ERROR] Could not enter the source directory.
exit /b 1
:fail_log
echo [ERROR] Could not create build-logs directory.
exit /b 1
:fail_source
echo [ERROR] Required source, global.json or shared .NET resolver is missing.
goto :fail
:fail_arch
echo [ERROR] This build requires Windows x64. ARM64/x86 are not supported.
goto :fail
:fail_sdk
echo [ERROR] Compatible .NET 10 SDK not found. No SignTool needed for this mode.
echo [INFO] See build-logs\R19_dev_sdk_discovery.log, R15_dotnet_probe.log.
goto :fail
:fail_publish
echo [ERROR] dotnet publish failed or self-contained payload is incomplete.
echo [INFO] See build-logs\R19_dev_wpf_publish.log. Previous dev output is preserved.
goto :fail
:fail_commit
echo [ERROR] Cannot retire previous dev backup; previous final output is preserved.
goto :fail
:fail_restore
REM Restore only the dev output. Never delete or rename signed installer artifacts.
if exist "%FINAL%" rmdir /s /q "%FINAL%"
if exist "%PREVIOUS%" move "%PREVIOUS%" "%FINAL%" >nul
echo [ERROR] Commit of dev build failed. Previous dev output restoration attempted.
goto :fail
:fail
if exist "%STAGE%" rmdir /s /q "%STAGE%"
if exist "%RESULT%" (
  > "%RESULT%" echo STATUS=FAILED
  >> "%RESULT%" echo MODE=DEVELOPMENT_UNSIGNED
  >> "%RESULT%" echo FAILED_STAGE=%FAILED_STAGE%
)
echo [FAILED] Stage=%FAILED_STAGE%. Official signed installer output untouched.
if "%NO_PAUSE%"=="0" pause
exit /b 1
:success
if "%NO_PAUSE%"=="0" pause
exit /b 0
